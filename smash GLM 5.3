            x.fillStyle = '#48b02c'; x.fillRect(20, 56, 8, 8); x.fillRect(36, 56, 8, 8);
            return c;
        }
        function createStageTexture() {
            const c = document.createElement('canvas'); c.width = 128; c.height = 128;
            const x = c.getContext('2d'); x.imageSmoothingEnabled = false;
            x.fillStyle = '#1e293b'; x.fillRect(0, 0, 128, 128);
            x.fillStyle = '#334155';
            for (let y = 0; y < 128; y += 32) x.fillRect(0, y, 128, 2);
            for (let i = 0; i < 128; i += 32) x.fillRect(i, 0, 2, 128);
            x.fillStyle = '#0f172a'; x.fillRect(10, 10, 12, 12); x.fillRect(70, 45, 18, 10); x.fillRect(40, 90, 15, 15);
            return c;
        }
        // --- Nouvelles textures de décor ---
        function createStarTexture() {
            const c = document.createElement('canvas'); c.width = 16; c.height = 16;
