            return c;
        }
        function createMoonTexture() {
            const c = document.createElement('canvas'); c.width = 64; c.height = 64;
            const x = c.getContext('2d');
            x.fillStyle = '#e8eef7'; x.beginPath(); x.arc(32, 32, 27, 0, 7); x.fill();
            x.fillStyle = '#c3cede'; x.beginPath(); x.arc(38, 36, 24, 0, 7); x.fill();
            x.fillStyle = '#e8eef7'; x.beginPath(); x.arc(30, 30, 22, 0, 7); x.fill();
            x.fillStyle = '#aab7cc';
            x.beginPath(); x.arc(22, 24, 5, 0, 7); x.fill();
            x.beginPath(); x.arc(36, 40, 4, 0, 7); x.fill();
            x.beginPath(); x.arc(40, 18, 3, 0, 7); x.fill();
            return c;
        }
        function createNebulaTexture() {
            const c = document.createElement('canvas'); c.width = 64; c.height = 64;
            const x = c.getContext('2d');
            for (let i = 0; i < 46; i++) {
                x.fillStyle = `rgba(255,255,255,${0.06 + Math.random() * 0.12})`;
                const s = 3 + Math.random() * 9;
                x.fillRect(32 - s + (Math.random() - 0.5) * 40, 32 - s / 2 + (Math.random() - 0.5) * 24, s * 2, s);
            }
            return c;
        }
        function createCityTexture() {
            const c = document.createElement('canvas'); c.width = 128; c.height = 64;
            const x = c.getContext('2d'); x.imageSmoothingEnabled = false;
            let px = 0;
            while (px < 128) {
                const w = 8 + Math.floor(Math.random() * 10), h = 18 + Math.floor(Math.random() * 26);
                x.fillStyle = '#0b1526'; x.fillRect(px, 64 - h, w, h);
                x.fillStyle = '#f5d76e';
                for (let wy = 64 - h + 3; wy < 60; wy += 5)
                    for (let wx = px + 2; wx < px + w - 2; wx += 4)
                        if (Math.random() < 0.4) x.fillRect(wx, wy, 2, 2);
                px += w + 2;
            }
            return c;
        }
        function createCloudTexture() {
            const c = document.createElement('canvas'); c.width = 64; c.height = 32;
            const x = c.getContext('2d'); x.imageSmoothingEnabled = false;
            x.fillStyle = '#e2e8f0';
            x.fillRect(8, 12, 48, 12); x.fillRect(16, 6, 30, 8); x.fillRect(4, 18, 56, 6);
            x.fillStyle = '#cbd5e1'; x.fillRect(8, 22, 48, 2);
