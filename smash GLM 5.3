<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DEGEN PEPE SMASH BROS 3D - PIXEL EDITION</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; overflow: hidden; user-select: none; background-color: #030308; font-family: 'Press Start 2P', monospace; color: #ffffff; }
        #game-canvas { width: 100vw; height: 100vh; display: block; }
        .pixelated { image-rendering: pixelated; image-rendering: crisp-edges; }
        .crt-overlay { background: linear-gradient(rgba(18,16,16,0) 50%, rgba(0,0,0,0.35) 50%); background-size: 100% 4px; pointer-events: none; }
        .pixel-box { border: 4px solid #ffffff; box-shadow: 4px 4px 0px #000000; image-rendering: pixelated; }
        .pixel-box-green { border: 4px solid #22c55e; box-shadow: 4px 4px 0px #052e16; }
        .pixel-box-red { border: 4px solid #ef4444; box-shadow: 4px 4px 0px #450a0a; }
        .pixel-box-yellow { border: 4px solid #eab308; box-shadow: 4px 4px 0px #422006; }
        .damage-pop { animation: floatUp 0.8s ease-out forwards; }
        @keyframes floatUp { 0% { opacity: 1; transform: translateY(0) scale(1); } 50% { transform: translateY(-30px) scale(1.4); } 100% { opacity: 0; transform: translateY(-55px) scale(0.8); } }
        .cd-bar-bg { background: #111827; border: 2px solid #475569; }
        .cd-bar-fill { background: #22c55e; transition: width 0.1s linear; }
        .cd-ready { box-shadow: 0 0 8px #22c55e; }
        /* Combo & K.O. */
        #combo-counter { transform: translateX(-50%); }
        .combo-pop { animation: comboPop 0.2s ease-out; }
        @keyframes comboPop { 0% { transform: translateX(-50%) scale(1.9) rotate(-4deg); } 100% { transform: translateX(-50%) scale(1) rotate(0deg); } }
        #ko-flash span { animation: koZoom 0.9s ease-out forwards; }
        @keyframes koZoom { 0% { transform: scale(3) rotate(-8deg); opacity: 0; } 25% { transform: scale(1) rotate(-3deg); opacity: 1; } 80% { opacity: 1; } 100% { transform: scale(1); opacity: 0; } }
    </style>
</head>
<body class="bg-black text-white select-none relative">

    <div class="crt-overlay fixed inset-0 z-30"></div>

    <!-- Options -->
    <div class="absolute top-4 right-4 z-40 flex gap-3">
        <button id="layout-toggle" onclick="toggleLayout()" class="pixel-box-yellow bg-yellow-900/90 hover:bg-yellow-800 text-yellow-300 p-2.5 text-xs font-bold transition cursor-pointer">CLAVIER: AZERTY</button>
        <button id="audio-toggle" onclick="toggleAudio()" class="pixel-box bg-slate-900/90 hover:bg-slate-800 text-green-400 p-2.5 text-xs font-bold transition cursor-pointer">SON: ON</button>
    </div>

    <!-- Sélection -->
    <div id="selection-screen" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950 z-20 p-4">
        <div class="text-center mb-4">
            <h1 class="text-3xl md:text-5xl font-black text-yellow-400 tracking-widest drop-shadow-[4px_4px_0px_#000] uppercase mb-2">DEGEN PEPE SMASH</h1>
            <p class="text-emerald-400 text-xs tracking-wider">ÉJECTION ROULEAU COMPRESSEUR PIXEL ART 3D — ÉDITION PUISSANCE MAXIMALE</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3 max-w-6xl w-full px-2 mb-4">
            <button onclick="selectCharacter(0)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-emerald-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-emerald-400 mb-2 p-1"><canvas id="preview-0" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-emerald-400 group-hover:text-white">TRACKSUIT</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">ÉQUILIBRÉ & RUSH</p>
                <div class="mt-2 text-[8px] bg-black text-emerald-300 p-1 w-full text-left border border-emerald-800">
                    <div>[J] Normal / Charge</div>
                    <div>[K] Lame Cyclone (1.5s)</div>
                    <div>[L] Giga Tornado (4.3s)</div>
                </div>
            </button>

            <button onclick="selectCharacter(1)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-slate-800 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-slate-300 mb-2 p-1"><canvas id="preview-1" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-slate-200 group-hover:text-white">CHEVALIER</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">LOURD & TANQUE</p>
                <div class="mt-2 text-[8px] bg-black text-slate-300 p-1 w-full text-left border border-slate-700">
                    <div>[J] Normal / Charge</div>
                    <div>[K] Onde Sismique (1.8s)</div>
                    <div>[L] Marteau Jugement (5s)</div>
                </div>
            </button>

            <button onclick="selectCharacter(2)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-purple-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-purple-400 mb-2 p-1"><canvas id="preview-2" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-purple-400 group-hover:text-white">VOLEUR</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">RAPIDE & CRITIQUE</p>
                <div class="mt-2 text-[8px] bg-black text-purple-300 p-1 w-full text-left border border-purple-800">
                    <div>[J] Normal / Charge</div>
                    <div>[K] Pas de l'Ombre + CRIT (2.2s)</div>
                    <div>[L] Pluie de Dagues (4s)</div>
                </div>
            </button>

            <button onclick="selectCharacter(3)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-amber-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-amber-400 mb-2 p-1"><canvas id="preview-3" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-amber-400 group-hover:text-white">ARCHER</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">TIR DISTANCE</p>
                <div class="mt-2 text-[8px] bg-black text-amber-300 p-1 w-full text-left border border-amber-800">
                    <div>[J] Normal / Charge</div>
                    <div>[K] Triple Volée (1.4s)</div>
                    <div>[L] Flèche Destruction (4.5s)</div>
                </div>
            </button>

            <button onclick="selectCharacter(4)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-cyan-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-cyan-400 mb-2 p-1"><canvas id="preview-4" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-cyan-400 group-hover:text-white">MAGE</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">SORTS & PROJECTION</p>
                <div class="mt-2 text-[8px] bg-black text-cyan-300 p-1 w-full text-left border border-cyan-800">
                    <div>[J] Normal / Charge</div>
                    <div>[K] Orbe Glacial — GÈLE (1.8s)</div>
                    <div>[L] Météore Smash (4.7s)</div>
                </div>
            </button>
        </div>

        <div class="pixel-box bg-slate-900 p-3 max-w-2xl w-full text-center">
            <h4 class="text-xs text-yellow-400 mb-2 tracking-widest">REGLES & COMMANDES</h4>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-[9px]">
                <div class="bg-black p-2 border border-slate-700"><span id="ctrl-move" class="text-yellow-400">Q / D</span><br><span class="text-slate-400">DÉPLACEMENT</span></div>
                <div class="bg-black p-2 border border-slate-700"><span id="ctrl-jump" class="text-yellow-400">Z / ESPACE</span><br><span class="text-slate-400">SAUT & DOUBLE SAUT</span></div>
                <div class="bg-black p-2 border border-slate-700"><span class="text-yellow-400">J (MAINTENIR)</span><br><span class="text-slate-400">CHARGE + LUNGÉ</span></div>
                <div class="bg-black p-2 border border-slate-700"><span class="text-yellow-400">K & L / SPECIAUX</span><br><span class="text-slate-400">GEL, BRÛLURE, CRIT, COMBOS</span></div>
            </div>
            <p class="text-[8px] text-red-400 mt-2">LIMITE : Éjection > 500 Miles = Out of Bounds. 3 Sorties pour Gagner !</p>
        </div>
    </div>

    <!-- HUD -->
    <div id="game-hud" class="absolute inset-x-0 bottom-4 flex justify-center items-end gap-6 pointer-events-none z-10" style="display:none">
        <div id="hud-p1" class="pixel-box-green bg-slate-950 p-3 w-60 text-center">
            <div class="text-[9px] text-emerald-400 tracking-wider mb-1">JOUEUR 1</div>
            <div id="p1-name" class="text-xs font-bold text-white truncate">PEPE TRACKSUIT</div>
            <div id="p1-percent" class="text-3xl font-black text-white my-1">0%</div>
            <div id="p1-status" class="text-[9px] h-3 mb-1 font-bold text-cyan-300"></div>
            <div id="p1-charge-container" class="w-full bg-gray-900 h-2 border border-white mb-2 relative hidden">
                <div id="p1-charge-bar" class="bg-yellow-400 h-full w-0"></div>
            </div>
            <div class="grid grid-cols-2 gap-1 text-[8px] mt-1 font-mono">
                <div class="bg-black p-1 border border-slate-700"><span id="p1-sk1" class="text-yellow-400">K</span><div id="p1-cd-k" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
                <div class="bg-black p-1 border border-slate-700"><span id="p1-sk2" class="text-yellow-400">L</span><div id="p1-cd-l" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
            </div>
            <div class="flex justify-center gap-2 mt-2 text-lg" id="p1-lives"></div>
        </div>

        <div class="text-2xl font-black text-yellow-400 italic pb-6 drop-shadow-[2px_2px_0px_#000]">VS</div>

        <div id="hud-p2" class="pixel-box-red bg-slate-950 p-3 w-60 text-center">
            <div class="text-[9px] text-red-400 tracking-wider mb-1">CPU (IA)</div>
            <div id="p2-name" class="text-xs font-bold text-white truncate">PEPE CHEVALIER</div>
            <div id="p2-percent" class="text-3xl font-black text-white my-1">0%</div>
            <div id="p2-status" class="text-[9px] h-3 mb-1 font-bold text-cyan-300"></div>
            <div class="grid grid-cols-2 gap-1 text-[8px] mt-1 font-mono opacity-80">
                <div class="bg-black p-1 border border-slate-700"><span id="p2-sk1" class="text-red-400">K</span><div id="p2-cd-k" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
                <div class="bg-black p-1 border border-slate-700"><span id="p2-sk2" class="text-red-400">L</span><div id="p2-cd-l" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
            </div>
            <div class="flex justify-center gap-2 mt-2 text-lg" id="p2-lives"></div>
        </div>
    </div>

    <!-- Combo -->
    <div id="combo-counter" class="absolute top-6 left-1/2 z-20 pointer-events-none text-3xl font-black text-orange-400 drop-shadow-[3px_3px_0px_#000]" style="display:none">×2 COMBO !</div>

    <!-- K.O. Flash -->
    <div id="ko-flash" class="absolute inset-0 z-30 items-center justify-center pointer-events-none" style="display:none">
        <span class="text-6xl md:text-8xl font-black text-red-500 drop-shadow-[6px_6px_0px_#000]">K.O. !</span>
    </div>

    <!-- Flèche hors-écran -->
    <div id="offscreen-arrow" class="absolute z-20 pointer-events-none items-center justify-center gap-1.5 bg-red-950/95 border-2 border-red-500 p-2 text-red-300 text-[10px] font-bold shadow-2xl animate-pulse" style="display:none">
        <span id="arrow-icon" class="text-lg inline-block">➔</span>
        <span id="arrow-dist">0.0 mi</span>
    </div>

    <!-- Fin de partie -->
    <div id="game-over" class="absolute inset-0 bg-black/90 flex-col items-center justify-center z-30" style="display:none">
        <h2 id="winner-title" class="text-4xl md:text-6xl font-black text-yellow-400 mb-2 tracking-widest drop-shadow-[4px_4px_0px_#000]">VICTOIRE !</h2>
        <p id="winner-sub" class="text-slate-300 mb-8 text-xs md:text-sm text-center px-4">Vous avez atomisé l'ennemi !</p>
        <button onclick="resetGame()" onmouseenter="playAudioHover()" class="pixel-box-yellow bg-yellow-500 hover:bg-yellow-400 text-black font-black px-8 py-4 text-sm transition cursor-pointer">REJOUER</button>
    </div>

    <div id="damage-container" class="absolute inset-0 pointer-events-none z-20 overflow-hidden"></div>

    <canvas id="game-canvas"></canvas>

    <script>
        // ==================== CONFIG CLAVIER ====================
        let currentLayout = 'AZERTY';
        function toggleLayout() {
            currentLayout = currentLayout === 'AZERTY' ? 'QWERTY' : 'AZERTY';
            document.getElementById('layout-toggle').innerText = `CLAVIER: ${currentLayout}`;
            const moveTxt = document.getElementById('ctrl-move');
            const jumpTxt = document.getElementById('ctrl-jump');
            if (currentLayout === 'AZERTY') { moveTxt.innerText = 'Q / D'; jumpTxt.innerText = 'Z / ESPACE'; }
            else { moveTxt.innerText = 'A / D'; jumpTxt.innerText = 'W / ESPACE'; }
            playAudioSelect();
        }

        // ==================== AUDIO 8-BIT ====================
        let audioCtx = null;
        let audioMuted = false;
        function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
        function toggleAudio() {
            audioMuted = !audioMuted;
            document.getElementById('audio-toggle').innerText = audioMuted ? "SON: OFF" : "SON: ON";
        }
        function playSoundSweep(startFreq, endFreq, type, duration, vol = 0.2) {
            if (audioMuted) return;
            initAudio();
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(startFreq, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(Math.max(1, endFreq), audioCtx.currentTime + duration);
                gain.gain.setValueAtTime(vol, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(); osc.stop(audioCtx.currentTime + duration);
            } catch (e) {}
        }
        function playNoise(duration, vol = 0.3) {
            if (audioMuted) return;
            initAudio();
            try {
                const bufferSize = audioCtx.sampleRate * duration;
                const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
                const noise = audioCtx.createBufferSource();
                noise.buffer = buffer;
                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(vol, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                noise.connect(gain); gain.connect(audioCtx.destination);
                noise.start();
            } catch (e) {}
        }
        function playAudioHover() { playSoundSweep(250, 500, 'square', 0.05, 0.05); }
        function playAudioSelect() { playSoundSweep(300, 800, 'triangle', 0.12, 0.15); }
        function playAudioJump() { playSoundSweep(140, 400, 'square', 0.12, 0.12); }
        function playAudioDoubleJump() { playSoundSweep(280, 650, 'square', 0.12, 0.12); }
        function playAudioHit(step = 1) { playSoundSweep(150 + step * 80, 50, 'sawtooth', 0.1, 0.2); playNoise(0.08, 0.15); }
        function playAudioSpecial(isCharged = false) {
            if (isCharged) { playSoundSweep(100, 950, 'sawtooth', 0.45, 0.35); playNoise(0.35, 0.35); }
            else playSoundSweep(300, 700, 'square', 0.2, 0.2);
        }
        function playAudioKO() { playNoise(0.4, 0.4); playSoundSweep(180, 30, 'sawtooth', 0.4, 0.3); }
        // Nouveaux sons
        function playAudioCrit() { playSoundSweep(500, 150, 'sawtooth', 0.18, 0.3); playSoundSweep(750, 250, 'square', 0.15, 0.2); }
        function playAudioFreeze() { playSoundSweep(1400, 400, 'sine', 0.35, 0.25); playSoundSweep(900, 300, 'triangle', 0.3, 0.2); }
        function playAudioTeleport() { playSoundSweep(200, 1200, 'sine', 0.12, 0.22); playSoundSweep(1200, 300, 'sine', 0.1, 0.15); }
        function playAudioTornado() { playNoise(0.7, 0.15); playSoundSweep(100, 320, 'triangle', 0.6, 0.15); }
        function playAudioMeteorFall() { playSoundSweep(60, 260, 'sawtooth', 0.7, 0.28); }
        function playAudioBigExplosion() { playNoise(0.5, 0.5); playSoundSweep(150, 35, 'sawtooth', 0.5, 0.4); }
        function playAudioDagger() { playSoundSweep(1200, 700, 'square', 0.05, 0.08); }
        function playAudioShock() { playSoundSweep(90, 40, 'square', 0.25, 0.3); playNoise(0.15, 0.2); }
        function playAudioReady() { playSoundSweep(500, 900, 'square', 0.08, 0.12); }

        // ==================== CONFIG PERSONNAGES ====================
        const CHAR_TYPES = [
            { name: "Pepe Tracksuit", speed: 0.22, weight: 1.0, cdK: 90, cdL: 260 },
            { name: "Pepe Chevalier", speed: 0.17, weight: 1.5, cdK: 110, cdL: 300 },
            { name: "Pepe Voleur", speed: 0.27, weight: 0.8, cdK: 130, cdL: 240 },
            { name: "Pepe Archer", speed: 0.20, weight: 0.9, cdK: 85, cdL: 270 },
            { name: "Pepe Mage", speed: 0.18, weight: 0.95, cdK: 110, cdL: 280 }
        ];
        const SKILL_NAMES = [
            { s1: 'CYCLONE', s2: 'TORNADO' },
            { s1: 'SEISME', s2: 'MARTEAU' },
            { s1: 'OMBRE', s2: 'DAGUES' },
            { s1: 'VOLEE', s2: 'BOOM' },
            { s1: 'GLACIAL', s2: 'METEORE' }
        ];

        // ==================== TEXTURES PIXEL ART ====================
        function createPepeTexture(typeIndex) {
            const canvas = document.createElement('canvas');
            canvas.width = 64; canvas.height = 64;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;
            ctx.clearRect(0, 0, 64, 64);
            ctx.fillStyle = '#48b02c'; ctx.fillRect(16, 8, 32, 24); ctx.fillRect(12, 16, 40, 16);
            ctx.fillStyle = '#d32f2f'; ctx.fillRect(18, 28, 28, 5);
            ctx.fillStyle = '#b71c1c'; ctx.fillRect(20, 31, 24, 2);
            ctx.fillStyle = '#ffffff'; ctx.fillRect(14, 12, 14, 10); ctx.fillRect(36, 12, 14, 10);
            ctx.fillStyle = '#388e3c'; ctx.fillRect(14, 12, 14, 4); ctx.fillRect(36, 12, 14, 4);
            ctx.fillStyle = '#000000'; ctx.fillRect(20, 18, 6, 3); ctx.fillRect(40, 18, 6, 3);
            if (typeIndex === 0) {
                ctx.fillStyle = '#f8fafc'; ctx.fillRect(14, 34, 36, 20);
                ctx.fillStyle = '#84cc16'; ctx.fillRect(30, 34, 4, 20); ctx.fillRect(14, 42, 36, 3);
                ctx.fillStyle = '#cbd5e1'; ctx.fillRect(52, 10, 4, 40);
                ctx.fillStyle = '#78350f'; ctx.fillRect(50, 42, 8, 3);
                ctx.fillStyle = '#ef4444'; ctx.fillRect(8, 36, 10, 14);
            } else if (typeIndex === 1) {
                ctx.fillStyle = '#94a3b8'; ctx.fillRect(20, 2, 24, 12); ctx.fillRect(28, 0, 8, 4);
                ctx.fillStyle = '#64748b'; ctx.fillRect(14, 34, 36, 22);
                ctx.fillStyle = '#94a3b8'; ctx.fillRect(50, 14, 12, 18);
                ctx.fillStyle = '#78350f'; ctx.fillRect(52, 8, 3, 46);
                ctx.fillStyle = '#d1d5db'; ctx.fillRect(4, 34, 12, 22);
            } else if (typeIndex === 2) {
                ctx.fillStyle = '#1e1b4b'; ctx.fillRect(12, 4, 40, 16); ctx.fillRect(10, 12, 8, 24);
                ctx.fillStyle = '#312e81'; ctx.fillRect(14, 34, 36, 22);
                ctx.fillStyle = '#e2e8f0'; ctx.fillRect(50, 36, 10, 4); ctx.fillRect(54, 32, 3, 12);
            } else if (typeIndex === 3) {
                ctx.fillStyle = '#78350f'; ctx.fillRect(14, 34, 36, 22);
                ctx.fillStyle = '#fef08a'; ctx.fillRect(20, 34, 24, 16);
                ctx.fillStyle = '#b45309'; ctx.fillRect(50, 16, 3, 36);
                ctx.fillStyle = '#f59e0b'; ctx.fillRect(8, 14, 6, 20);
            } else if (typeIndex === 4) {
                ctx.fillStyle = '#475569'; ctx.fillRect(12, 32, 40, 26);
                ctx.fillStyle = '#78350f'; ctx.fillRect(6, 8, 4, 52);
                ctx.fillStyle = '#0284c7'; ctx.fillRect(4, 4, 8, 8);
                ctx.fillStyle = '#7c2d12'; ctx.fillRect(44, 40, 12, 14);
            }
            ctx.fillStyle = '#48b02c'; ctx.fillRect(20, 56, 8, 8); ctx.fillRect(36, 56, 8, 8);
            return canvas;
        }

        function createStageTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 128; canvas.height = 128;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;
            ctx.fillStyle = '#1e293b'; ctx.fillRect(0, 0, 128, 128);
            ctx.fillStyle = '#334155';
            for (let y = 0; y < 128; y += 32) ctx.fillRect(0, y, 128, 2);
            for (let x = 0; x < 128; x += 32) ctx.fillRect(x, 0, 2, 128);
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(10, 10, 12, 12); ctx.fillRect(70, 45, 18, 10); ctx.fillRect(40, 90, 15, 15);
            return canvas;
        }

        CHAR_TYPES.forEach((char, index) => {
            const previewCanvas = document.getElementById(`preview-${index}`);
            if (previewCanvas) {
                const ctx = previewCanvas.getContext('2d');
                const pepeCv = createPepeTexture(index);
                ctx.imageSmoothingEnabled = false;
                ctx.drawImage(pepeCv, 0, 0, 64, 64, 0, 0, previewCanvas.width, previewCanvas.height);
            }
        });

        // ==================== MOTEUR & ÉTAT GLOBAL ====================
        let scene, camera, renderer;
        let p1, p2;
        let stage = { platforms: [] };
        let projectiles = [], meteors = [], tornados = [], daggers = [], shocks = [];
        let particles = [];
        let keys = {};
        let gameActive = false;
        let player1Type = 0, player2Type = 1;

        // Nouveaux systèmes de "game feel"
        let hitstop = 0;       // gel dramatique à l'impact
        let screenShake = 0;   // tremblement d'écran
        let comboCount = 0;    // compteur de combos
        let comboTimer = 0;
        let cpuThinkTimer = 0, cpuMoveDir = 0;
        let lastFrameTime = 0;

        function addShake(v) { screenShake = Math.max(screenShake, v); }

        // ==================== ENTRÉES ====================
        window.addEventListener('keydown', e => {
            keys[e.code] = true;
            if (!gameActive || !p1 || e.repeat) return;
            const jumpKey = currentLayout === 'AZERTY' ? 'KeyZ' : 'KeyW';
            if (e.code === jumpKey || e.code === 'Space' || e.code === 'ArrowUp') p1.jump();
            if (e.code === 'KeyJ') p1.startBasicCharge();
            if (e.code === 'KeyK') p1.attackSpecial1();
            if (e.code === 'KeyL') p1.attackSpecial2();
        });
        window.addEventListener('keyup', e => {
            keys[e.code] = false;
            if (!gameActive || !p1) return;
            if (e.code === 'KeyJ') p1.releaseBasicCharge();
        });
        window.addEventListener('mousedown', e => {
            if (!gameActive || !p1) return;
            if (e.button === 0) p1.startBasicCharge();
            if (e.button === 2) p1.attackSpecial1();
        });
        window.addEventListener('mouseup', e => {
            if (!gameActive || !p1) return;
            if (e.button === 0) p1.releaseBasicCharge();
        });
        window.addEventListener('contextmenu', e => e.preventDefault());

        function handleInput() {
            const left = currentLayout === 'AZERTY' ? (keys['KeyQ'] || keys['ArrowLeft']) : (keys['KeyA'] || keys['ArrowLeft']);
            const right = keys['KeyD'] || keys['ArrowRight'];
            if (left) p1.move(-1);
            if (right) p1.move(1);
        }

        // ==================== SCÈNE & DÉCOR ====================
        function initScene() {
            const canvas = document.getElementById('game-canvas');
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x030308);
            camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 6, 32);
            renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: false });
            renderer.setSize(window.innerWidth, window.innerHeight);
            const ambient = new THREE.AmbientLight(0xffffff, 0.9);
            scene.add(ambient);
            const dirLight = new THREE.DirectionalLight(0xffffff, 0.6);
            dirLight.position.set(10, 20, 15);
            scene.add(dirLight);
            createRetroDecor();
            window.addEventListener('resize', onWindowResize);
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function createRetroDecor() {
            const stageGroup = new THREE.Group();
            const stageTex = new THREE.CanvasTexture(createStageTexture());
            stageTex.magFilter = THREE.NearestFilter;
            stageTex.minFilter = THREE.NearestFilter;
            stageTex.wrapS = THREE.RepeatWrapping;
            stageTex.wrapT = THREE.RepeatWrapping;
            stageTex.repeat.set(4, 1);
            const mainMesh = new THREE.Mesh(new THREE.BoxGeometry(26, 2, 6), new THREE.MeshLambertMaterial({ map: stageTex }));
            mainMesh.position.y = -1.0;
            stageGroup.add(mainMesh);
            const edgeMesh = new THREE.Mesh(new THREE.BoxGeometry(26.2, 0.2, 6.2), new THREE.MeshBasicMaterial({ color: 0x2563eb }));
            edgeMesh.position.y = 0.0;
            stageGroup.add(edgeMesh);
            const bottomMesh = new THREE.Mesh(new THREE.ConeGeometry(12, 8, 4), new THREE.MeshLambertMaterial({ color: 0x0f172a }));
            bottomMesh.rotation.x = Math.PI;
            bottomMesh.position.y = -5.0;
            stageGroup.add(bottomMesh);
            const pGeo = new THREE.BoxGeometry(7, 0.4, 4);
            const pMat = new THREE.MeshLambertMaterial({ color: 0x334155 });
            const pL = new THREE.Mesh(pGeo, pMat); pL.position.set(-7.5, 4.2, 0); stageGroup.add(pL);
            const pLE = new THREE.Mesh(new THREE.BoxGeometry(7.2, 0.1, 4.2), new THREE.MeshBasicMaterial({ color: 0x9333ea }));
            pLE.position.set(-7.5, 4.4, 0); stageGroup.add(pLE);
            const pR = new THREE.Mesh(pGeo, pMat); pR.position.set(7.5, 4.2, 0); stageGroup.add(pR);
            const pRE = new THREE.Mesh(new THREE.BoxGeometry(7.2, 0.1, 4.2), new THREE.MeshBasicMaterial({ color: 0xd97706 }));
            pRE.position.set(7.5, 4.4, 0); stageGroup.add(pRE);
            scene.add(stageGroup);

            for (let i = 0; i < 6; i++) {
                const mMesh = new THREE.Mesh(new THREE.ConeGeometry(8 + Math.random() * 6, 12 + Math.random() * 8, 4), new THREE.MeshBasicMaterial({ color: 0x0f172a, wireframe: true }));
                mMesh.position.set((i - 2.5) * 16, 2, -25);
                scene.add(mMesh);
            }
            const statueTex = new THREE.CanvasTexture(createPepeTexture(0));
            statueTex.magFilter = THREE.NearestFilter;
            const statueMesh = new THREE.Mesh(new THREE.PlaneGeometry(16, 16), new THREE.MeshBasicMaterial({ map: statueTex, transparent: true, opacity: 0.22 }));
            statueMesh.position.set(0, 10, -22);
            scene.add(statueMesh);

            const pillarGeo = new THREE.BoxGeometry(1.6, 9, 1.6);
            const pillarMat = new THREE.MeshLambertMaterial({ color: 0x334155 });
            const pil1 = new THREE.Mesh(pillarGeo, pillarMat); pil1.position.set(-12, 3.5, -1);
            const pil2 = new THREE.Mesh(pillarGeo, pillarMat); pil2.position.set(12, 3.5, -1);
            scene.add(pil1); scene.add(pil2);
            [pil1, pil2].forEach(p => {
                const torch = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.8, 0.8), new THREE.MeshBasicMaterial({ color: 0xf59e0b }));
                torch.position.set(p.position.x, 8.2, p.position.z);
                scene.add(torch);
            });

            stage.platforms = [
                { topY: 0.1, minX: -13.1, maxX: 13.1 },
                { topY: 4.45, minX: -11.1, maxX: -3.9 },
                { topY: 4.45, minX: 3.9, maxX: 11.1 }
            ];
        }

        // ==================== SYSTÈME DE PARTICULES AMÉLIORÉ ====================
        function registerParticle(entry) {
            if (particles.length > 380) {
                const old = particles.shift();
                scene.remove(old.mesh);
            }
            particles.push(entry);
        }

        function createDustParticle(x, y, colorHex, size = 0.22) {
            const mesh = new THREE.Mesh(new THREE.PlaneGeometry(size, size), new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.85 }));
            mesh.position.set(x, y, 0);
            scene.add(mesh);
            registerParticle({ mesh, vx: (Math.random() - 0.5) * 0.06, vy: Math.random() * 0.06, life: 18, maxLife: 18, baseOpacity: 0.85 });
        }

        // Onde de choc circulaire qui s'étend
        function createShockwave(x, y, color, maxRadius = 5, speed = 14) {
            const mesh = new THREE.Mesh(new THREE.RingGeometry(0.4, 0.62, 24), new THREE.MeshBasicMaterial({ color, side: THREE.DoubleSide, transparent: true, opacity: 0.9 }));
            mesh.position.set(x, y, 0.3);
            scene.add(mesh);
            registerParticle({ mesh, vx: 0, vy: 0, life: speed, maxLife: speed, grow: maxRadius / speed, baseOpacity: 0.9 });
        }

        // Ghost / traînée du personnage
        function createAfterimage(x, y, texture, color = 0x88ccff, flipX = false) {
            const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2.4, 2.4), new THREE.MeshBasicMaterial({ map: texture, transparent: true, opacity: 0.45, color, alphaTest: 0.02, side: THREE.DoubleSide }));
            mesh.position.set(x, y, -0.2);
            if (flipX) mesh.scale.x = -1;
            scene.add(mesh);
            registerParticle({ mesh, vx: 0, vy: 0, life: 12, maxLife: 12, baseOpacity: 0.5 });
        }

        function createSlashParticle(x, y, scale = 1) {
            const mesh = new THREE.Mesh(new THREE.RingGeometry(0.3 * scale, 1.1 * scale, 10, 1, 0, Math.PI * 0.85), new THREE.MeshBasicMaterial({ color: 0xffffff, side: THREE.DoubleSide, transparent: true, opacity: 0.9 }));
            mesh.position.set(x, y, 0.15);
            scene.add(mesh);
            registerParticle({ mesh, vx: 0, vy: 0, life: 8, maxLife: 8, spin: 0.5, baseOpacity: 0.9 });
        }

        // Cercle d'avertissement au sol (télégraphe des ultimes)
        function createTelegraph(x, color, life) {
            const mesh = new THREE.Mesh(new THREE.RingGeometry(2.6, 3.1, 24), new THREE.MeshBasicMaterial({ color, side: THREE.DoubleSide, transparent: true, opacity: 0.9 }));
            mesh.position.set(x, 0.15, 0.25);
            scene.add(mesh);
            registerParticle({ mesh, vx: 0, vy: 0, life: life, maxLife: life, pulse: true, baseOpacity: 0.9 });
        }

        function createHitSpark(x, y) {
            for (let i = 0; i < 14; i++) {
                createDustParticle(x + (Math.random() - 0.5) * 0.8, y + (Math.random() - 0.5) * 0.8, i % 2 ? 0xfacc15 : 0xffffff, 0.18 + Math.random() * 0.15);
            }
        }

        function createExplosion(x, y) {
            for (let i = 0; i < 36; i++) {
                createDustParticle(x + (Math.random() - 0.5) * 3.5, y + (Math.random() - 0.5) * 3.5, [0xef4444, 0xf97316, 0xfbbf24][i % 3], 0.3 + Math.random() * 0.25);
            }
        }

        function createSmokeBurst(x, y) {
            for (let i = 0; i < 16; i++) {
                createDustParticle(x + (Math.random() - 0.5) * 1.5, y + (Math.random() - 0.5) * 2, Math.random() < 0.5 ? 0xa855f7 : 0x312e81, 0.3);
            }
        }

        // Grosse explosion AoE avec dégâts + statuts
        function createBigExplosion(x, y, owner, damage, radius, kbStrength, opts = {}) {
            for (let i = 0; i < 45; i++) {
                const colors = [0xef4444, 0xf97316, 0xfbbf24, 0xfde68a];
                createDustParticle(x + (Math.random() - 0.5) * radius, y + (Math.random() - 0.5) * radius, colors[Math.floor(Math.random() * 4)], 0.3 + Math.random() * 0.3);
            }
            createShockwave(x, y, 0xfbbf24, radius * 2.2, 12);
            createShockwave(x, y, 0xef4444, radius * 1.4, 10);
            addShake(1.0);
            hitstop = Math.max(hitstop, 8);
            playAudioBigExplosion();

            const target = (owner === p1) ? p2 : p1;
            if (!target || target.invuln > 0) return;
            const dx = target.position.x - x;
            const dy = target.position.y - y;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d < radius) {
                const away = Math.sign(dx) || 1;
                const kb = (target.percent / 5 + damage) * kbStrength / target.config.weight;
                target.applyHit(damage, away * kb, kb * 0.85 + 0.3, opts);
                if (opts.burn) target.burnTicks = 75; // 3 ticks de brûlure
            }
        }

        function updateParticles() {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.life--;
                p.mesh.position.x += p.vx || 0;
                p.mesh.position.y += p.vy || 0;
                if (p.grow) p.mesh.scale.setScalar(p.mesh.scale.x + p.grow);
                else if (p.pulse) {
                    const t = p.maxLife - p.life;
                    p.mesh.scale.setScalar(1 + Math.sin(t * 0.45) * 0.2);
                } else p.mesh.scale.multiplyScalar(0.93);
                if (p.spin) p.mesh.rotation.z += p.spin;
                if (p.mesh.material && p.mesh.material.transparent) {
                    p.mesh.material.opacity = Math.max(0, (p.life / p.maxLife)) * (p.baseOpacity !== undefined ? p.baseOpacity : 0.8);
                }
                if (p.life <= 0) {
                    scene.remove(p.mesh);
                    if (p.mesh.material) p.mesh.material.dispose();
                    if (p.mesh.geometry) p.mesh.geometry.dispose();
                    particles.splice(i, 1);
                }
            }
        }

        // ==================== TEXTES FLOTTANTS ====================
        function spawnFloatText(pos3D, text, cssClass, size = 24) {
            const container = document.getElementById('damage-container');
            if (!container) return;
            const tempV = pos3D.clone();
            tempV.project(camera);
            const x = (tempV.x * 0.5 + 0.5) * window.innerWidth;
            const y = (-tempV.y * 0.5 + 0.5) * window.innerHeight;
            const el = document.createElement('div');
            el.className = `absolute font-black damage-pop drop-shadow-[2px_2px_0px_#000] ${cssClass}`;
            el.style.left = `${x}px`;
            el.style.top = `${y}px`;
            el.style.fontSize = `${size}px`;
            el.innerText = text;
            container.appendChild(el);
            setTimeout(() => el.remove(), 800);
        }

        function spawnDamageText(pos3D, amount, opts = {}) {
            const size = Math.min(64, 22 + amount * 1.4);
            if (opts.crit) spawnFloatText(pos3D, `CRIT ${amount}% !`, 'text-red-400', size + 8);
            else if (opts.burn) spawnFloatText(pos3D, `${amount}%`, 'text-orange-400', 18);
            else spawnFloatText(pos3D, `${amount}%`, 'text-yellow-400', size);
        }

        // ==================== CLASSE PEPE FIGHTER ====================
        class PepeFighter {
            constructor(typeIndex, isCPU = false, startX = 0) {
                this.typeIndex = typeIndex;
                this.config = CHAR_TYPES[typeIndex];
                this.isCPU = isCPU;

                this.percent = 0;
                this.lives = 3;
                this.isGrounded = false;
                this.facingRight = !isCPU;
                this.canDoubleJump = true;
                this.age = 0;

                // Cooldowns
                this.attackCooldown = 0;
                this.cdTimerK = 0;
                this.cdTimerL = 0;
                this.prevCdK = 0;
                this.prevCdL = 0;

                // Charge de base
                this.isChargingBase = false;
                this.baseChargePower = 0;

                // Statuts
                this.frozen = 0;      // gel
                this.burnTicks = 0;   // brûlure
                this.empowered = false; // coup critique prêt (voleur)
                this.invuln = 0;      // invulnérabilité respawn

                // Dash Lame Cyclone
                this.dashFrames = 0;
                this.dashDir = 1;
                this.dashHit = false;

                // Plongeon sismique (chevalier en l'air)
                this.pendingShock = false;

                this.velocity = new THREE.Vector3();
                this.position = new THREE.Vector3(startX, 6, 0);
                this.halfWidth = 0.85;
                this.feetOffset = 1.2;

                this.mesh = this.createMesh();
                scene.add(this.mesh);
            }

            createMesh() {
                const group = new THREE.Group();
                const textureCanvas = createPepeTexture(this.typeIndex);
                const texture = new THREE.CanvasTexture(textureCanvas);
                texture.magFilter = THREE.NearestFilter;
                texture.minFilter = THREE.NearestFilter;
                this.spriteTexture = texture;

                const mat = new THREE.MeshBasicMaterial({ map: texture, transparent: true, alphaTest: 0.1, side: THREE.DoubleSide });
                this.spriteMesh = new THREE.Mesh(new THREE.PlaneGeometry(2.4, 2.4), mat);
                group.add(this.spriteMesh);

                // Bloc de glace (affiché quand gelé)
                this.iceMesh = new THREE.Mesh(new THREE.BoxGeometry(2.4, 2.7, 1.3), new THREE.MeshBasicMaterial({ color: 0x7dd3fc, transparent: true, opacity: 0.35 }));
                this.iceMesh.visible = false;
                group.add(this.iceMesh);

                // Tag
                const tagCanvas = document.createElement('canvas');
                tagCanvas.width = 64; tagCanvas.height = 32;
                const tctx = tagCanvas.getContext('2d');
                tctx.fillStyle = this.isCPU ? '#ef4444' : '#22c55e';
                tctx.font = 'bold 20px monospace';
                tctx.textAlign = 'center';
                tctx.fillText(this.isCPU ? 'CPU' : 'P1', 32, 22);
                const tagMesh = new THREE.Mesh(new THREE.PlaneGeometry(1.2, 0.6), new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(tagCanvas), transparent: true }));
                tagMesh.position.y = 1.5;
                group.add(tagMesh);

                group.position.copy(this.position);
                return group;
            }

            update() {
                this.age++;

                // --- STATUTS ---
                if (this.frozen > 0) {
                    this.frozen--;
                    this.velocity.x *= 0.75;
                    this.velocity.y *= 0.55; // suspendu dans la glace
                    this.spriteMesh.material.color.setHex(0x7dd3fc);
                    this.iceMesh.visible = true;
                    if (Math.random() < 0.35) createDustParticle(this.position.x + (Math.random() - 0.5) * 1.8, this.position.y + (Math.random() - 0.5) * 2.2, 0xe0f2fe);
                } else if (this.burnTicks > 0) {
                    this.burnTicks--;
                    this.spriteMesh.material.color.setHex(0xffaa66);
                    this.iceMesh.visible = false;
                    if (Math.random() < 0.5) createDustParticle(this.position.x + (Math.random() - 0.5), this.position.y + (Math.random() - 0.5) * 2, 0xff6a00);
                    if (this.burnTicks % 25 === 0) {
                        this.percent += 2;
                        spawnDamageText(this.position, 2, { burn: true });
                        updateHUD();
                    }
                } else {
                    this.spriteMesh.material.color.setHex(0xffffff);
                    this.iceMesh.visible = false;
                }

                if (this.invuln > 0) {
                    this.invuln--;
                    this.spriteMesh.visible = Math.floor(this.invuln / 4) % 2 === 0;
                } else {
                    this.spriteMesh.visible = true;
                }

                // Aura de critique prêt (voleur)
                if (this.empowered && Math.random() < 0.4) {
                    createDustParticle(this.position.x + (Math.random() - 0.5) * 1.8, this.position.y + (Math.random() - 0.5) * 2.2, 0xa855f7);
                }

                // --- PHYSIQUE ---
                this.velocity.y -= 0.022;
                this.velocity.x *= 0.86;

                // --- DASH LAME CYCLONE ---
                if (this.dashFrames > 0) {
                    this.dashFrames--;
                    if (!this.isGrounded) this.velocity.y = Math.max(this.velocity.y, -0.04);
                    createAfterimage(this.position.x, this.position.y, this.spriteTexture, 0x22d3ee, !this.facingRight);
                    const opp = (this === p1) ? p2 : p1;
                    if (!this.dashHit && opp && opp.invuln <= 0 && this.position.distanceTo(opp.position) < 2.1) {
                        this.dashHit = true;
                        this.dashFrames = 0;
                        const dmg = 15;
                        const kb = (opp.percent / 5 + dmg) * 0.055 / opp.config.weight;
                        opp.applyHit(dmg, this.dashDir * kb, kb * 0.55 + 0.24);
                        createSlashParticle(opp.position.x, opp.position.y, 1.5);
                        playAudioHit(4);
                    }
                }

                // --- COOLDOWNS ---
                if (this.cdTimerK > 0) this.cdTimerK--;
                if (this.cdTimerL > 0) this.cdTimerL--;
                if (this.attackCooldown > 0) this.attackCooldown--;

                // --- CHARGE DE BASE ---
                if (this.isChargingBase) {
                    this.baseChargePower = Math.min(100, this.baseChargePower + 3);
                    this.spriteMesh.rotation.z = (Math.random() - 0.5) * 0.35;
                    if (this.age % 2 === 0) createDustParticle(this.position.x + (Math.random() - 0.5) * 2, this.position.y + (Math.random() - 0.5) * 2, 0xfacc15);
                    if (!this.isCPU && this === p1) {
                        const chargeBox = document.getElementById('p1-charge-container');
                        const chargeBar = document.getElementById('p1-charge-bar');
                        if (chargeBox && chargeBar) {
                            chargeBox.classList.remove('hidden');
                            chargeBar.style.width = `${this.baseChargePower}%`;
                        }
                    }
                    if (this.baseChargePower >= 100) this.releaseBasicCharge();
                } else {
                    this.spriteMesh.rotation.z *= 0.8;
                }

                // --- COLLISION SOL ---
                const prevY = this.position.y;
                const nextY = this.position.y + this.velocity.y;
                const nextX = this.position.x + this.velocity.x;
                this.position.x = nextX;

                let landed = false;
                this.isGrounded = false;
                const prevFeetY = prevY - this.feetOffset;
                const nextFeetY = nextY - this.feetOffset;

                if (this.velocity.y <= 0) {
                    for (let plat of stage.platforms) {
                        if (this.position.x + this.halfWidth >= plat.minX && this.position.x - this.halfWidth <= plat.maxX) {
                            if (prevFeetY >= plat.topY - 0.2 && nextFeetY <= plat.topY) {
                                this.position.y = plat.topY + this.feetOffset;
                                this.velocity.y = 0;
                                this.isGrounded = true;
                                this.canDoubleJump = true;
                                landed = true;
                                break;
                            }
                        }
                    }
                }

                // Plongeon sismique : onde de choc à l'atterrissage
                if (landed && this.pendingShock) {
                    this.pendingShock = false;
                    shocks.push(new GroundShock(this.position.x, this, 1));
                    shocks.push(new GroundShock(this.position.x, this, -1));
                    addShake(0.5);
                    playAudioShock();
                    for (let i = 0; i < 8; i++) createDustParticle(this.position.x + (Math.random() - 0.5) * 2, 0.4, 0x94a3b8);
                }

                if (!landed) this.position.y = nextY;

                // --- ORIENTATION ---
                if (Math.abs(this.velocity.x) > 0.02 && this.dashFrames <= 0) {
                    this.facingRight = this.velocity.x > 0;
                }
                this.spriteMesh.scale.x = this.facingRight ? 1 : -1;
                this.mesh.position.copy(this.position);

                // --- BLAST ZONES ---
                const distMiles = Math.abs(this.position.x) * 20;
                if (distMiles > 500 || this.position.y < -12 || this.position.y > 22) {
                    this.takeKO();
                }
            }

            jump() {
                if (this.frozen > 0) return; // gelé = pas de saut
                if (this.isGrounded) {
                    this.velocity.y = 0.46;
                    playAudioJump();
                    this.createDustEffect();
                } else if (this.canDoubleJump) {
                    this.velocity.y = 0.42;
                    this.canDoubleJump = false;
                    playAudioDoubleJump();
                    this.createDustEffect();
                }
            }

            move(dir) {
                if (this.frozen > 0) dir *= 0.25; // gelé = ralenti
                this.velocity.x += dir * this.config.speed * 0.26;
            }

            // --- CHARGE D'ATTAQUE DE BASE (J) ---
            startBasicCharge() {
                if (this.attackCooldown > 0 || this.isChargingBase || this.frozen > 0) return;
                this.isChargingBase = true;
                this.baseChargePower = 10;
            }

            releaseBasicCharge() {
                if (!this.isChargingBase) return;
                this.isChargingBase = false;

                const chargeBox = document.getElementById('p1-charge-container');
                if (chargeBox) chargeBox.classList.add('hidden');

                const ratio = this.baseChargePower / 100;
                this.attackCooldown = 12;

                let dirX, dirY;
                if (!this.isCPU) {
                    dirX = this.facingRight ? 1 : -1;
                    dirY = 0.35;
                    const leftKey = currentLayout === 'AZERTY' ? (keys['KeyQ'] || keys['ArrowLeft']) : (keys['KeyA'] || keys['ArrowLeft']);
                    const rightKey = keys['KeyD'] || keys['ArrowRight'];
                    const upKey = (currentLayout === 'AZERTY' ? keys['KeyZ'] : keys['KeyW']) || keys['ArrowUp'];
                    if (leftKey) dirX = -1;
                    if (rightKey) dirX = 1;
                    if (upKey) { dirY = 1.0; if (!leftKey && !rightKey) dirX *= 0.3; }
                } else {
                    dirX = this.facingRight ? 1 : -1;
                    dirY = 0.35;
                }

                // Lungé propulsé à forte charge
                if (ratio > 0.6) {
                    this.velocity.x += dirX * (0.15 + ratio * 0.4);
                    if (dirY > 0.5) this.velocity.y += ratio * 0.15;
                }

                this.spriteMesh.position.x = dirX * 0.5;
                setTimeout(() => { if (this.spriteMesh) this.spriteMesh.position.x = 0; }, 120);

                createSlashParticle(this.position.x + dirX * 1.4, this.position.y, 0.8 + ratio * 1.6);

                const opponent = (this === p1) ? p2 : p1;
                const dist = this.position.distanceTo(opponent.position);

                if (dist < 2.8 + ratio * 0.8) {
                    let damage = Math.floor(9 + ratio * 22);
                    let kbMult = 1;
                    let crit = false;
                    // CRITIQUE DU VOLEUR (après Pas de l'Ombre)
                    if (this.empowered) {
                        damage = Math.floor(damage * 1.6);
                        kbMult = 1.45;
                        crit = true;
                        this.empowered = false;
                        createShockwave(opponent.position.x, opponent.position.y, 0xa855f7, 4, 10);
                        playAudioCrit();
                    }
                    const knockback = (opponent.percent / 5 + damage) * (0.045 + ratio * 0.06) * kbMult / opponent.config.weight;
                    opponent.applyHit(damage, dirX * knockback, dirY * knockback + 0.18, { crit });
                    playAudioHit(3);
                }
                this.baseChargePower = 0;
            }

            // --- SPÉCIALE 1 (K) ---
            attackSpecial1() {
                if (this.cdTimerK > 0 || this.frozen > 0) return;
                this.cdTimerK = this.config.cdK;
                const dir = this.facingRight ? 1 : -1;
                playAudioSpecial(false);

                if (this.typeIndex === 0) {
                    // LAME CYCLONE : dash traversant avec afterimages
                    this.dashFrames = 16;
                    this.dashDir = dir;
                    this.dashHit = false;
                    this.velocity.x = dir * 1.15;
                } else if (this.typeIndex === 1) {
                    // SECOUSSE SISMIQUE : ondes de choc au sol
                    if (this.isGrounded) {
                        this.velocity.y = 0.32;
                        shocks.push(new GroundShock(this.position.x, this, dir));
                        shocks.push(new GroundShock(this.position.x, this, -dir));
                        addShake(0.4);
                        playAudioShock();
                    } else {
                        this.velocity.y = -0.8; // plongeon
                        this.pendingShock = true;
                    }
                } else if (this.typeIndex === 2) {
                    // PAS DE L'OMBRE : téléport derrière l'ennemi + CRIT prêt
                    const enemy = (this === p1) ? p2 : p1;
                    createSmokeBurst(this.position.x, this.position.y);
                    const startX = this.position.x;
                    const sign = Math.sign(enemy.position.x - startX) || 1;
                    const endX = Math.max(-12.5, Math.min(12.5, enemy.position.x - sign * 2.0));
                    for (let i = 1; i < 5; i++) {
                        createAfterimage(startX + (endX - startX) * i / 5, this.position.y, this.spriteTexture, 0xa855f7, !this.facingRight);
                    }
                    this.position.x = endX;
                    this.facingRight = enemy.position.x >= this.position.x;
                    createSmokeBurst(this.position.x, this.position.y);
                    this.empowered = true;
                    this.attackCooldown = 0;
                    playAudioTeleport();
                    spawnFloatText(this.position, 'CRIT PRET !', 'text-purple-400', 18);
                } else if (this.typeIndex === 3) {
                    // TRIPLE VOLÉE : 3 flèches
                    projectiles.push(new Projectile(this.position.x + dir * 1.2, this.position.y, dir, 0xfbbf24, this, 'arrow', 0.03));
                    projectiles.push(new Projectile(this.position.x + dir * 1.2, this.position.y + 0.5, dir, 0xfbbf24, this, 'arrow', 0.07));
                    projectiles.push(new Projectile(this.position.x + dir * 1.2, this.position.y - 0.35, dir, 0xfbbf24, this, 'arrow', -0.03));
                } else if (this.typeIndex === 4) {
                    // ORBE GLACIAL
                    projectiles.push(new Projectile(this.position.x + dir * 1.2, this.position.y, dir, 0x7dd3fc, this, 'frost'));
                }
            }

            // --- SPÉCIALE 2 / ULTIME (L) ---
            attackSpecial2() {
                if (this.cdTimerL > 0 || this.frozen > 0) return;
                this.cdTimerL = this.config.cdL;
                playAudioSpecial(true);
                const enemy = (this === p1) ? p2 : p1;
                spawnFloatText(this.position, 'SUPER !', this.isCPU ? 'text-red-400' : 'text-emerald-400', 26);
                addShake(0.35);
                createShockwave(this.position.x, this.position.y, 0xfbbf24, 3, 8);

                if (this.typeIndex === 0) {
                    // GIGA TORNADO : aspire, multi-touche et éjecte
                    const dir = this.facingRight ? 1 : -1;
                    tornados.push(new Tornado(this.position.x + dir * 1.8, this, dir));
                } else if (this.typeIndex === 1) {
                    // MARTEAU DU JUGEMENT : marteau spectral qui suit la cible
                    meteors.push(new Meteor(enemy.position.x, this, 'hammer'));
                } else if (this.typeIndex === 2) {
                    // PLUIE DE DAGUES : 8 dagues à tête chercheuse
                    this.velocity.y = 0.5;
                    for (let i = 0; i < 8; i++) {
                        daggers.push(new HomingDagger(this.position.x + (Math.random() - 0.5), this.position.y + 1.2, this, 12 + i * 4));
                    }
                } else if (this.typeIndex === 3) {
                    // FLÈCHE DESTRUCTION : explosion AoE + brûlure
                    const dir = this.facingRight ? 1 : -1;
                    projectiles.push(new Projectile(this.position.x + dir * 1.6, this.position.y, dir, 0xef4444, this, 'boom'));
                } else if (this.typeIndex === 4) {
                    // MÉTÉORE SMASH
                    meteors.push(new Meteor(enemy.position.x, this, 'meteor'));
                }
            }

            applyHit(damage, kbX, kbY, opts = {}) {
                if (this.invuln > 0 || !gameActive) return;
                this.percent += damage;
                this.velocity.x += kbX;
                this.velocity.y += kbY;

                // Combo
                comboCount++;
                comboTimer = 80;
                updateComboDisplay();

                // Game feel : hitstop + screenshake proportionnels
                hitstop = opts.light ? 2 : Math.min(10, 3 + Math.floor(damage / 7));
                addShake(opts.light ? 0.06 : 0.15 + damage * 0.018);

                spawnDamageText(this.position, damage, opts);
                createHitSpark(this.position.x, this.position.y);
                if (damage >= 18) createShockwave(this.position.x, this.position.y, 0xfbbf24, 3 + damage * 0.1, 10);

                updateHUD();
            }

            takeKO() {
                this.lives--;
                this.percent = 0;
                playAudioKO();
                createExplosion(this.position.x, this.position.y);
                createShockwave(this.position.x, this.position.y, 0xffffff, 8, 16);
                addShake(1.4);
                hitstop = 10;
                showKOFlash();
                updateHUD();

                if (this.lives <= 0) {
                    endGame(this === p1 ? "CPU" : "JOUEUR 1");
                } else {
                    this.position.set(this.isCPU ? 5 : -5, 8, 0);
                    this.velocity.set(0, 0, 0);
                    this.invuln = 90;
                    this.frozen = 0;
                    this.burnTicks = 0;
                    this.empowered = false;
                    this.isChargingBase = false;
                    this.baseChargePower = 0;
                    this.dashFrames = 0;
                    this.pendingShock = false;
                    if (!this.isCPU) {
                        const cb = document.getElementById('p1-charge-container');
                        if (cb) cb.classList.add('hidden');
                    }
                }
            }

            createDustEffect() {
                for (let i = 0; i < 5; i++) {
                    createDustParticle(this.position.x + (Math.random() - 0.5), this.position.y - 1.2, 0x64748b);
                }
            }
        }

        // ==================== PROJECTILES (flèches / orbe / boom) ====================
        class Projectile {
            constructor(x, y, dir, color, owner, kind = 'arrow', vy = 0) {
                this.position = new THREE.Vector3(x, y, 0);
                this.dir = dir;
                this.vy = vy;
                this.owner = owner;
                this.kind = kind;
                this.alive = true;
                this.age = 0;

                if (kind === 'arrow') {
                    this.speed = 0.9;
                    this.mesh = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.16, 0.16), new THREE.MeshBasicMaterial({ color: 0xfbbf24 }));
                } else if (kind === 'frost') {
                    this.speed = 0.34;
                    const g = new THREE.Group();
                    g.add(new THREE.Mesh(new THREE.SphereGeometry(0.55, 10, 10), new THREE.MeshBasicMaterial({ color: 0x7dd3fc, transparent: true, opacity: 0.9 })));
                    g.add(new THREE.Mesh(new THREE.RingGeometry(0.7, 0.95, 20), new THREE.MeshBasicMaterial({ color: 0xe0f2fe, side: THREE.DoubleSide, transparent: true, opacity: 0.6 })));
                    this.mesh = g;
                } else { // boom
                    this.speed = 0.62;
                    const g = new THREE.Group();
                    g.add(new THREE.Mesh(new THREE.BoxGeometry(2.4, 0.42, 0.42), new THREE.MeshBasicMaterial({ color: 0xef4444 })));
                    const tip = new THREE.Mesh(new THREE.ConeGeometry(0.35, 0.8, 6), new THREE.MeshBasicMaterial({ color: 0xfbbf24 }));
                    tip.rotation.z = -Math.PI / 2 * dir;
                    tip.position.x = dir * 1.5;
                    g.add(tip);
                    this.mesh = g;
                }
                this.mesh.position.copy(this.position);
                scene.add(this.mesh);
            }

            update() {
                this.age++;
                this.position.x += this.dir * this.speed;
                this.position.y += this.vy;
                if (this.kind === 'arrow') this.vy -= 0.004;
                this.mesh.position.copy(this.position);
                if (this.kind === 'frost') this.mesh.rotation.y += 0.2;

                if (this.age % 2 === 0) {
                    const c = this.kind === 'arrow' ? 0xfde68a : (this.kind === 'frost' ? 0xe0f2fe : 0xef4444);
                    createDustParticle(this.position.x, this.position.y, c);
                }

                const target = (this.owner === p1) ? p2 : p1;
                const hitR = this.kind === 'boom' ? 1.9 : (this.kind === 'frost' ? 1.7 : 1.4);

                if (target && target.invuln <= 0 && this.position.distanceTo(target.position) < hitR) {
                    if (this.kind === 'arrow') {
                        const dmg = 7;
                        const kb = (target.percent / 5 + dmg) * 0.028 / target.config.weight;
                        target.applyHit(dmg, this.dir * kb, kb * 0.8 + 0.14, { light: true });
                        createHitSpark(this.position.x, this.position.y);
                        playAudioHit(2);
                        this.alive = false;
                    } else if (this.kind === 'frost') {
                        const dmg = 12;
                        const kb = (target.percent / 5 + dmg) * 0.04 / target.config.weight;
                        target.applyHit(dmg, this.dir * kb, kb * 0.5 + 0.1);
                        target.frozen = 85; // GEL !
                        playAudioFreeze();
                        spawnFloatText(target.position, 'GELE !', 'text-cyan-300', 22);
                        createShockwave(target.position.x, target.position.y, 0x7dd3fc, 3.5, 10);
                        for (let i = 0; i < 14; i++) createDustParticle(target.position.x + (Math.random() - 0.5) * 1.5, target.position.y + (Math.random() - 0.5) * 2, 0xe0f2fe);
                        this.alive = false;
                    } else {
                        createBigExplosion(this.position.x, this.position.y, this.owner, 26, 4.5, 0.07, { burn: true });
                        this.alive = false;
                    }
                    return;
                }

                if (Math.abs(this.position.x) > 30 || this.position.y < -3) {
                    if (this.kind === 'boom') createBigExplosion(this.position.x, Math.max(this.position.y, 1), this.owner, 26, 4.5, 0.07, { burn: true });
                    this.alive = false;
                }
            }
        }

        // ==================== MÉTÉORE / MARTEAU (chutes du ciel) ====================
        class Meteor {
            constructor(targetX, owner, kind = 'meteor') {
                this.kind = kind;
                this.owner = owner;
                this.x = targetX;
                this.y = 20;
                this.alive = true;
                this.telegraph = kind === 'hammer' ? 34 : 22;
                this.speed = kind === 'hammer' ? 0.85 : 0.6;
                this.age = 0;

                if (kind === 'meteor') {
                    this.mesh = new THREE.Mesh(new THREE.SphereGeometry(1.5, 8, 8), new THREE.MeshBasicMaterial({ color: 0xea580c }));
                    const core = new THREE.Mesh(new THREE.SphereGeometry(1.0, 8, 8), new THREE.MeshBasicMaterial({ color: 0xfbbf24 }));
                    core.position.z = 0.3;
                    this.mesh.add(core);
                } else {
                    const g = new THREE.Group();
                    g.add(new THREE.Mesh(new THREE.BoxGeometry(3.4, 2.0, 2.0), new THREE.MeshBasicMaterial({ color: 0xfacc15, transparent: true, opacity: 0.85 })));
                    const handle = new THREE.Mesh(new THREE.BoxGeometry(0.5, 3.4, 0.5), new THREE.MeshBasicMaterial({ color: 0x92400e }));
                    handle.position.y = 2.6;
                    g.add(handle);
                    this.mesh = g;
                }
                this.mesh.position.set(this.x, this.y, 0);
                scene.add(this.mesh);
                createTelegraph(this.x, kind === 'hammer' ? 0xfacc15 : 0xef4444, this.telegraph);
            }

            update() {
                this.age++;
                if (this.telegraph > 0) {
                    this.telegraph--;
                    this.mesh.rotation.z += this.kind === 'hammer' ? 0.1 : 0.2;
                    // Le marteau suit la cible pendant la télégraphe
                    if (this.kind === 'hammer') {
                        const target = (this.owner === p1) ? p2 : p1;
                        this.x += (target.position.x - this.x) * 0.06;
                        this.mesh.position.x = this.x;
                    }
                    if (this.telegraph === 0) playAudioMeteorFall();
                    return;
                }
                this.y -= this.speed;
                this.mesh.position.y = this.y;
                this.mesh.rotation.z += this.kind === 'hammer' ? 0.35 : 0.25;

                if (this.kind === 'meteor' && this.age % 2 === 0) {
                    createDustParticle(this.x + (Math.random() - 0.5), this.y + 1.8, Math.random() < 0.5 ? 0xf97316 : 0xfbbf24, 0.35);
                }

                if (this.y <= 1.4) {
                    if (this.kind === 'meteor') {
                        createBigExplosion(this.x, 1.2, this.owner, 32, 5.5, 0.075, { burn: true });
                    } else {
                        createBigExplosion(this.x, 1.0, this.owner, 30, 5.0, 0.085, {});
                        for (let i = 0; i < 10; i++) createDustParticle(this.x + (Math.random() - 0.5) * 2, 0.5, 0x64748b, 0.3);
                        addShake(1.3);
                    }
                    this.alive = false;
                }
            }
        }

        // ==================== TORNADO (Tracksuit ultime) ====================
        class Tornado {
            constructor(x, owner, dir) {
                this.x = x;
                this.dir = dir;
                this.owner = owner;
                this.life = 120;
                this.hitCooldown = 0;
                this.hits = 0;
                this.alive = true;
                this.age = 0;

                this.mesh = new THREE.Group();
                this.rings = [];
                for (let i = 0; i < 7; i++) {
                    const r = 0.45 + i * 0.32;
                    const ring = new THREE.Mesh(
                        new THREE.RingGeometry(r, r + 0.3, 22),
                        new THREE.MeshBasicMaterial({ color: i % 2 ? 0x38bdf8 : 0xe0f2fe, transparent: true, opacity: 0.55, side: THREE.DoubleSide })
                    );
                    ring.rotation.x = Math.PI / 2;
                    ring.position.y = 0.3 + i * 0.55;
                    this.mesh.add(ring);
                    this.rings.push(ring);
                }
                this.mesh.position.set(x, 0, 0);
                scene.add(this.mesh);
                playAudioTornado();
            }

            update() {
                this.age++;
                this.life--;
                this.x += this.dir * 0.09;
                this.mesh.position.x = this.x;

                // Ondulation vivante
                this.rings.forEach((ring, i) => {
                    ring.position.y = 0.3 + i * 0.55 + Math.sin(this.age * 0.2 + i) * 0.12;
                    ring.position.x = Math.sin(this.age * 0.15 + i * 1.3) * 0.15;
                });

                if (this.age % 2 === 0) createDustParticle(this.x + (Math.random() - 0.5) * 2.2, 0.3 + Math.random() * 3, 0x38bdf8);

                if (this.hitCooldown > 0) this.hitCooldown--;

                const target = (this.owner === p1) ? p2 : p1;
                if (target && target.invuln <= 0 &&
                    Math.abs(target.position.x - this.x) < 2.3 &&
                    target.position.y < 5.5 && target.position.y > -1) {
                    // Aspiration + envol
                    target.velocity.y = Math.max(target.velocity.y, 0.08);
                    target.position.x += (this.x - target.position.x) * 0.05;

                    if (this.hitCooldown <= 0 && this.hits < 5) {
                        this.hits++;
                        this.hitCooldown = 16;
                        target.applyHit(6, this.dir * 0.02, 0.1, { light: true });
                        if (this.hits === 5) {
                            // Final : éjection massive
                            const kb = (target.percent / 5 + 10) * 0.075 / target.config.weight;
                            target.applyHit(10, this.dir * kb, kb + 0.35);
                            createShockwave(target.position.x, target.position.y, 0x38bdf8, 5, 12);
                        }
                    }
                }

                if (this.life <= 0) this.alive = false;
            }
        }

        // ==================== DAGUES À TÊTE CHERCHEUSE (Voleur ultime) ====================
        class HomingDagger {
            constructor(x, y, owner, delay = 0) {
                this.position = new THREE.Vector3(x, y, 0);
                this.velocity = new THREE.Vector3((Math.random() - 0.5) * 0.25, 0.15, 0);
                this.owner = owner;
                this.delay = delay;
                this.life = 130;
                this.alive = true;

                this.mesh = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.12, 0.12), new THREE.MeshBasicMaterial({ color: 0xe2e8f0 }));
                this.mesh.position.copy(this.position);
                scene.add(this.mesh);
            }

            update() {
                if (this.delay > 0) { this.delay--; this.mesh.visible = false; return; }
                this.mesh.visible = true;
                this.life--;

                const target = (this.owner === p1) ? p2 : p1;
                if (target) {
                    const dx = target.position.x - this.position.x;
                    const dy = target.position.y - this.position.y;
                    const len = Math.max(0.001, Math.sqrt(dx * dx + dy * dy));
                    this.velocity.x += (dx / len) * 0.05;
                    this.velocity.y += (dy / len) * 0.05;
                }

                const sp = Math.sqrt(this.velocity.x * this.velocity.x + this.velocity.y * this.velocity.y);
                if (sp > 0.42) {
                    this.velocity.x = this.velocity.x / sp * 0.42;
                    this.velocity.y = this.velocity.y / sp * 0.42;
                }

                this.position.add(this.velocity);
                this.mesh.position.copy(this.position);
                this.mesh.rotation.z = Math.atan2(this.velocity.y, this.velocity.x);

                if (Math.random() < 0.6) createDustParticle(this.position.x, this.position.y, 0xa855f7, 0.16);

                if (target && target.invuln <= 0 && this.position.distanceTo(target.position) < 1.1) {
                    const kb = (target.percent / 5 + 4) * 0.012 / target.config.weight;
                    target.applyHit(4, this.velocity.x * 0.3, kb + 0.05, { light: true });
                    createHitSpark(this.position.x, this.position.y);
                    playAudioDagger();
                    this.alive = false;
                    return;
                }

                if (this.life <= 0 || this.position.y < -2) this.alive = false;
            }
        }

        // ==================== ONDE DE CHOC AU SOL (Chevalier K) ====================
        class GroundShock {
            constructor(x, owner, dir) {
                this.x = x;
                this.dir = dir;
                this.owner = owner;
                this.alive = true;
                this.life = 48;
                this.age = 0;
                this.hit = false;
                this.speed = 0.45;

                this.mesh = new THREE.Group();
                this.rocks = [];
                const rockColors = [0xf59e0b, 0xd97706, 0x92400e];
                for (let i = 0; i < 4; i++) {
                    const rock = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.35, 0.35), new THREE.MeshBasicMaterial({ color: rockColors[i % 3] }));
                    rock.position.set((Math.random() - 0.5) * 0.8, 0.3, 0);
                    this.mesh.add(rock);
                    this.rocks.push(rock);
                }
                this.mesh.position.set(x, 0.35, 0.2);
                scene.add(this.mesh);
            }

            update() {
                this.age++;
                this.life--;
                this.x += this.dir * this.speed;
                this.mesh.position.x = this.x;

                this.rocks.forEach((r, i) => {
                    r.position.y = 0.3 + Math.abs(Math.sin(this.age * 0.35 + i)) * 0.6;
                    r.rotation.x += 0.3;
                    r.rotation.y += 0.2;
                });

                if (this.age % 3 === 0) createDustParticle(this.x, 0.3, 0xd97706);

                const target = (this.owner === p1) ? p2 : p1;
                if (target && !this.hit && target.invuln <= 0 &&
                    target.position.y < 2.4 && Math.abs(target.position.x - this.x) < 1.5) {
                    this.hit = true;
                    const dmg = 16;
                    const kb = (target.percent / 5 + dmg) * 0.055 / target.config.weight;
                    target.applyHit(dmg, this.dir * kb, kb * 1.2 + 0.28);
                    createShockwave(this.x, 1.0, 0xf59e0b, 3, 10);
                    for (let i = 0; i < 10; i++) createDustParticle(this.x + (Math.random() - 0.5) * 2, 0.8, 0xf59e0b);
                    this.alive = false;
                    return;
                }

                if (this.life <= 0) this.alive = false;
            }
        }

        // ==================== HUD ====================
        function percentColor(pct) {
            if (pct < 50) return '#ffffff';
            if (pct < 100) return '#facc15';
            if (pct < 150) return '#f97316';
            return '#ef4444';
        }

        function updateHUD() {
            if (!p1 || !p2) return;
            const e1 = document.getElementById('p1-percent');
            const e2 = document.getElementById('p2-percent');
            e1.innerText = `${Math.floor(p1.percent)}%`;
            e2.innerText = `${Math.floor(p2.percent)}%`;
            e1.style.color = percentColor(p1.percent);
            e2.style.color = percentColor(p2.percent);

            document.getElementById('p1-name').innerText = p1.config.name.toUpperCase();
            document.getElementById('p2-name').innerText = p2.config.name.toUpperCase();

            const st1 = document.getElementById('p1-status');
            const st2 = document.getElementById('p2-status');
            st1.innerText = p1.frozen > 0 ? 'GELE !' : (p1.burnTicks > 0 ? 'BRULE !' : (p1.empowered ? 'CRIT PRET' : ''));
            st2.innerText = p2.frozen > 0 ? 'GELE !' : (p2.burnTicks > 0 ? 'BRULE !' : '');

            const l1 = document.getElementById('p1-lives');
            const l2 = document.getElementById('p2-lives');
            let h1 = '', h2 = '';
            for (let i = 0; i < p1.lives; i++) h1 += '<span class="text-emerald-400">■</span>';
            for (let i = 0; i < p2.lives; i++) h2 += '<span class="text-red-400">■</span>';
            l1.innerHTML = h1 || '<span class="text-slate-600">■</span>';
            l2.innerHTML = h2 || '<span class="text-slate-600">■</span>';

            document.getElementById('p1-sk1').innerText = `K: ${SKILL_NAMES[p1.typeIndex].s1}`;
            document.getElementById('p1-sk2').innerText = `L: ${SKILL_NAMES[p1.typeIndex].s2}`;
            document.getElementById('p2-sk1').innerText = `K: ${SKILL_NAMES[p2.typeIndex].s1}`;
            document.getElementById('p2-sk2').innerText = `L: ${SKILL_NAMES[p2.typeIndex].s2}`;
        }

        function updateBar(id, timer, max) {
            const bar = document.getElementById(id);
            if (!bar || !max) return;
            const fill = bar.children[0];
            const ready = timer <= 0;
            const ratio = ready ? 1 : 1 - timer / max;
            fill.style.width = `${(ratio * 100).toFixed(1)}%`;
            fill.style.background = ready ? '#22c55e' : '#64748b';
            const box = bar.parentElement;
            if (box) { if (ready) box.classList.add('cd-ready'); else box.classList.remove('cd-ready'); }
        }

        function updateCooldownHUD() {
            if (!p1 || !p2) return;
            updateBar('p1-cd-k', p1.cdTimerK, p1.config.cdK);
            updateBar('p1-cd-l', p1.cdTimerL, p1.config.cdL);
            updateBar('p2-cd-k', p2.cdTimerK, p2.config.cdK);
            updateBar('p2-cd-l', p2.cdTimerL, p2.config.cdL);
            // Bip quand un sort redevient dispo (joueur seulement)
            if (p1.prevCdK > 0 && p1.cdTimerK === 0) playAudioReady();
            if (p1.prevCdL > 0 && p1.cdTimerL === 0) playAudioReady();
            p1.prevCdK = p1.cdTimerK;
            p1.prevCdL = p1.cdTimerL;
        }

        function updateComboDisplay() {
            const el = document.getElementById('combo-counter');
            if (comboCount >= 2 && comboTimer > 0) {
                el.style.display = 'block';
                el.innerText = `×${comboCount} COMBO !`;
                el.classList.remove('combo-pop');
                void el.offsetWidth;
                el.classList.add('combo-pop');
            } else {
                el.style.display = 'none';
            }
        }

        function showKOFlash() {
            const el = document.getElementById('ko-flash');
            const span = el.querySelector('span');
            el.style.display = 'flex';
            span.style.animation = 'none';
            void span.offsetWidth;
            span.style.animation = '';
            setTimeout(() => { el.style.display = 'none'; }, 950);
        }

        // ==================== SUIVI HORS ÉCRAN ====================
        function updateOffscreenTracker() {
            const arrowElem = document.getElementById('offscreen-arrow');
            const distElem = document.getElementById('arrow-dist');
            const iconElem = document.getElementById('arrow-icon');

            if (!gameActive || !p1 || !p2) { arrowElem.style.display = 'none'; return; }

            const proj = p2.position.clone().project(camera);
            const isOffscreen = proj.x < -0.9 || proj.x > 0.9 || proj.y < -0.9 || proj.y > 0.9;

            if (isOffscreen) {
                arrowElem.style.display = 'flex';
                const margin = 60;
                let screenX = (proj.x * 0.5 + 0.5) * window.innerWidth;
                let screenY = (-proj.y * 0.5 + 0.5) * window.innerHeight;
                screenX = Math.max(margin, Math.min(window.innerWidth - margin, screenX));
                screenY = Math.max(margin, Math.min(window.innerHeight - margin, screenY));
                arrowElem.style.left = `${screenX}px`;
                arrowElem.style.top = `${screenY}px`;

                const dx = p2.position.x - p1.position.x;
                const dy = p2.position.y - p1.position.y;
                const angleDeg = Math.atan2(dy, dx) * (180 / Math.PI);
                iconElem.style.transform = `rotate(${-angleDeg}deg)`;

                const distanceMiles = Math.floor(Math.abs(p2.position.x) * 20);
                distElem.innerText = `${distanceMiles} mi`;
                if (distanceMiles >= 400) distElem.classList.add('text-yellow-400');
                else distElem.classList.remove('text-yellow-400');
            } else {
                arrowElem.style.display = 'none';
            }
        }

        // ==================== IA DU CPU ====================
        function updateCPU() {
            if (!p2 || !p1 || !gameActive) return;
            if (p2.frozen > 0) return;

            const dx = p1.position.x - p2.position.x;
            const dy = p1.position.y - p2.position.y;
            const dist = Math.abs(dx);
            const dirToPlayer = dx > 0 ? 1 : -1;

            // Récupération : hors plateau et en dessous
            const offStage = p2.position.x < -13.5 || p2.position.x > 13.5;
            if (offStage && p2.position.y < 2) {
                if ((p2.isGrounded || p2.canDoubleJump) && p2.velocity.y < 0.1) p2.jump();
                p2.move(p2.position.x > 0 ? -1 : 1);
                return;
            }

            // Relâche sa charge quand elle est assez puissante
            if (p2.isChargingBase) {
                p2.facingRight = dx > 0;
                if (p2.baseChargePower > 50 + Math.random() * 40) p2.releaseBasicCharge();
                return;
            }

            p2.facingRight = dx > 0;

            cpuThinkTimer--;
            if (cpuThinkTimer <= 0) {
                cpuThinkTimer = 30 + Math.random() * 40;
                cpuMoveDir = Math.random() < 0.75 ? dirToPlayer : (Math.random() < 0.5 ? -dirToPlayer : 0);
            }

            const isRanged = p2.typeIndex === 3 || p2.typeIndex === 4;

            if (isRanged) {
                if (dist < 5) cpuMoveDir = -dirToPlayer;
                else if (dist > 11) cpuMoveDir = dirToPlayer;
                if (cpuMoveDir !== 0) p2.move(cpuMoveDir);
                if (dist > 4 && dist < 18) {
                    if (p2.cdTimerK <= 0 && Math.random() < 0.06) p2.attackSpecial1();
                    if (p2.cdTimerL <= 0 && Math.random() < 0.035) p2.attackSpecial2();
                }
                if (dy > 2 && p2.cdTimerK <= 0 && Math.random() < 0.04) p2.attackSpecial1();
            } else {
                if (dist > 2.2 && cpuMoveDir !== 0) p2.move(cpuMoveDir);
                if (dy > 1.5 && p2.isGrounded && Math.random() < 0.12) p2.jump();

                if (dist < 3 && p2.attackCooldown <= 0 && !p2.isChargingBase && Math.random() < 0.14) p2.startBasicCharge();
                if (dist < 3.2 && p2.cdTimerK <= 0 && Math.random() < 0.045) p2.attackSpecial1();
                if (dist < 4.5 && p2.cdTimerL <= 0 && Math.random() < 0.028) p2.attackSpecial2();
            }

            // Voleur : téléport agressive si loin ou si le joueur charge
            if (p2.typeIndex === 2 && p2.cdTimerK <= 0 && Math.random() < 0.05) {
                if (dist > 4 || (dist < 2.5 && p1.isChargingBase)) p2.attackSpecial1();
            }
        }

        // ==================== CAMÉRA DYNAMIQUE + SCREENSHAKE ====================
        function updateCamera() {
            if (!p1 || !p2) return;
            const midX = (p1.position.x + p2.position.x) / 2;
            const midY = (p1.position.y + p2.position.y) / 2;
            const spread = Math.abs(p1.position.x - p2.position.x);

            const targetX = Math.max(-7, Math.min(7, midX * 0.65));
            const targetY = 5.5 + Math.max(0, midY - 2.5) * 0.35;
            const targetZ = Math.max(30, Math.min(46, 26 + spread * 0.75));

            camera.position.x += (targetX - camera.position.x) * 0.07 + (Math.random() - 0.5) * screenShake;
            camera.position.y += (targetY - camera.position.y) * 0.07 + (Math.random() - 0.5) * screenShake * 0.7;
            camera.position.z += (targetZ - camera.position.z) * 0.045;

            screenShake *= 0.87;
            if (screenShake < 0.005) screenShake = 0;
        }

        // ==================== FLUX DE JEU ====================
        function clearBattleEffects() {
            [projectiles, meteors, tornados, daggers, shocks].forEach(arr => {
                arr.forEach(o => scene.remove(o.mesh));
                arr.length = 0;
            });
            particles.forEach(p => scene.remove(p.mesh));
            particles.length = 0;
        }

        function selectCharacter(index) {
            player1Type = index;
            let cpu = Math.floor(Math.random() * 5);
            if (cpu === index) cpu = (index + 1 + Math.floor(Math.random() * 4)) % 5;
            player2Type = cpu;
            startGame();
        }

        function startGame() {
            initAudio();
            document.getElementById('selection-screen').style.display = 'none';
            document.getElementById('game-hud').style.display = 'flex';
            document.getElementById('game-over').style.display = 'none';
            document.getElementById('offscreen-arrow').style.display = 'none';
            document.getElementById('combo-counter').style.display = 'none';

            if (p1) scene.remove(p1.mesh);
            if (p2) scene.remove(p2.mesh);
            clearBattleEffects();

            comboCount = 0;
            comboTimer = 0;
            hitstop = 0;
            screenShake = 0;
            cpuThinkTimer = 0;

            p1 = new PepeFighter(player1Type, false, -5);
            p2 = new PepeFighter(player2Type, true, 5);
            gameActive = true;

            updateHUD();
            playAudioSelect();
        }

        function resetGame() {
            gameActive = false;
            clearBattleEffects();
            document.getElementById('game-over').style.display = 'none';
            document.getElementById('selection-screen').style.display = 'flex';
            document.getElementById('game-hud').style.display = 'none';
            document.getElementById('combo-counter').style.display = 'none';
            document.getElementById('offscreen-arrow').style.display = 'none';
        }

        function endGame(winner) {
            gameActive = false;
            clearBattleEffects();
            const title = document.getElementById('winner-title');
            const sub = document.getElementById('winner-sub');
            if (winner === 'JOUEUR 1') {
                title.innerText = 'VICTOIRE !';
                title.className = 'text-4xl md:text-6xl font-black text-yellow-400 mb-2 tracking-widest drop-shadow-[4px_4px_0px_#000]';
                sub.innerText = 'Vous avez atomisé le CPU au-delà des 500 miles !';
            } else {
                title.innerText = 'DÉFAITE...';
                title.className = 'text-4xl md:text-6xl font-black text-red-500 mb-2 tracking-widest drop-shadow-[4px_4px_0px_#000]';
                sub.innerText = 'Le CPU vous a éjecté au-delà des 500 miles !';
            }
            document.getElementById('game-over').style.display = 'flex';
            playAudioKO();
        }

        // ==================== BOUCLE PRINCIPALE (limitée à ~60fps) ====================
        function updateArray(arr) {
            for (let i = arr.length - 1; i >= 0; i--) {
                arr[i].update();
                if (!arr[i].alive) {
                    scene.remove(arr[i].mesh);
                    arr.splice(i, 1);
                }
            }
        }

        function animate(ts = 0) {
            requestAnimationFrame(animate);
            if (lastFrameTime && ts - lastFrameTime < 13) { renderer.render(scene, camera); return; }
            lastFrameTime = ts;

            if (!gameActive || !p1 || !p2) {
                updateParticles();
                renderer.render(scene, camera);
                return;
            }

            // HITSTOP : gel dramatique à l'impact
            if (hitstop > 0) {
                hitstop--;
                updateParticles();
                updateCamera();
                renderer.render(scene, camera);
                return;
            }

            handleInput();
            updateCPU();

            p1.update();
            p2.update();

            updateArray(projectiles);
            updateArray(meteors);
            updateArray(tornados);
            updateArray(daggers);
            updateArray(shocks);

            updateParticles();
            updateCamera();
            updateOffscreenTracker();
            updateCooldownHUD();

            // Flamme des braséros
            if (Math.random() < 0.25) {
                createDustParticle(-12 + (Math.random() - 0.5) * 0.4, 8.6, 0xf59e0b, 0.18);
                createDustParticle(12 + (Math.random() - 0.5) * 0.4, 8.6, 0xf59e0b, 0.18);
            }

            // Decay du combo
            if (comboTimer > 0) {
                comboTimer--;
                if (comboTimer === 0) {
                    comboCount = 0;
                    updateComboDisplay();
                }
            }

            renderer.render(scene, camera);
        }

        // ==================== DÉMARRAGE ====================
        initScene();
        animate();
    </script>
</body>
</html>
