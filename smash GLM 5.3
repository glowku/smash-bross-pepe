            x.fillStyle = '#fbbf24'; x.fillRect(0, 0, 32, 3); x.fillRect(0, 61, 32, 3); x.fillRect(0, 0, 3, 64); x.fillRect(29, 0, 3, 64);
            x.fillRect(12, 18, 8, 8); x.fillRect(14, 30, 4, 10); x.fillRect(10, 28, 4, 4); x.fillRect(18, 28, 4, 4);
