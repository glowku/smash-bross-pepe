<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DEGEN PEPE SMASH BROS 3D - PIXEL EDITION</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; overflow: hidden; user-select: none; background-color: #030308; font-family: 'Press Start 2P', monospace; color: #ffffff; }
        #game-canvas { width: 100vw; height: 100vh; display: block; }
        .pixelated { image-rendering: pixelated; image-rendering: crisp-edges; }
        .crt-overlay { background: linear-gradient(rgba(18,16,16,0) 50%, rgba(0,0,0,0.35) 50%); background-size: 100% 4px; pointer-events: none; }
        .pixel-box { border: 4px solid #ffffff; box-shadow: 4px 4px 0px #000000; image-rendering: pixelated; }
        .pixel-box-green { border: 4px solid #22c55e; box-shadow: 4px 4px 0px #052e16; }
        .pixel-box-red { border: 4px solid #ef4444; box-shadow: 4px 4px 0px #450a0a; }
        .pixel-box-yellow { border: 4px solid #eab308; box-shadow: 4px 4px 0px #422006; }
        .damage-pop { animation: floatUp 0.8s ease-out forwards; }
        @keyframes floatUp { 0% { opacity: 1; transform: translateY(0) scale(1); } 50% { transform: translateY(-30px) scale(1.4); } 100% { opacity: 0; transform: translateY(-55px) scale(0.8); } }
        .cd-bar-bg { background: #111827; border: 2px solid #475569; }
        .cd-bar-fill { background: #22c55e; transition: width 0.1s linear; }
        .cd-ready { box-shadow: 0 0 8px #22c55e; }
        #combo-counter { transform: translateX(-50%); }
        .combo-pop { animation: comboPop 0.2s ease-out; }
        @keyframes comboPop { 0% { transform: translateX(-50%) scale(1.9) rotate(-4deg); } 100% { transform: translateX(-50%) scale(1) rotate(0deg); } }
        #ko-flash span { animation: koZoom 0.9s ease-out forwards; }
        @keyframes koZoom { 0% { transform: scale(3) rotate(-8deg); opacity: 0; } 25% { transform: scale(1) rotate(-3deg); opacity: 1; } 80% { opacity: 1; } 100% { transform: scale(1); opacity: 0; } }
        .off-arrow { position: absolute; z-index: 25; pointer-events: none; display: none; align-items: center; gap: 8px; padding: 6px 10px; box-shadow: 4px 4px 0 #000; }
    </style>
</head>
<body class="bg-black text-white select-none relative">

    <div class="crt-overlay fixed inset-0 z-30"></div>

    <!-- Options -->
    <div class="absolute top-4 right-4 z-40 flex gap-3">
        <button id="layout-toggle" onclick="toggleLayout()" class="pixel-box-yellow bg-yellow-900/90 hover:bg-yellow-800 text-yellow-300 p-2.5 text-xs font-bold transition cursor-pointer">CLAVIER: AZERTY</button>
        <button id="audio-toggle" onclick="toggleAudio()" class="pixel-box bg-slate-900/90 hover:bg-slate-800 text-green-400 p-2.5 text-xs font-bold transition cursor-pointer">SON: ON</button>
    </div>

    <!-- Sélection -->
    <div id="selection-screen" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950 z-20 p-4 overflow-y-auto">
        <div class="text-center mb-4">
            <h1 class="text-3xl md:text-5xl font-black text-yellow-400 tracking-widest drop-shadow-[4px_4px_0px_#000] uppercase mb-2">DEGEN PEPE SMASH</h1>
            <p class="text-emerald-400 text-xs tracking-wider">ÉJECTION 3000 MILES — PIXEL ART 3D — ÉDITION SURCHARGÉE</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3 max-w-6xl w-full px-2 mb-4">
            <button onclick="selectCharacter(0)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-emerald-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-emerald-400 mb-2 p-1"><canvas id="preview-0" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-emerald-400 group-hover:text-white">TRACKSUIT</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">ÉQUILIBRÉ & RUSH</p>
                <div class="mt-2 text-[8px] bg-black text-emerald-300 p-1 w-full text-left border border-emerald-800">
                    <div>[J] Charge → Éjecte</div>
                    <div>[K] Cyclone (charger)</div>
                    <div>[L] Giga Tornado 3000mi</div>
                </div>
            </button>
            <button onclick="selectCharacter(1)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-slate-800 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-slate-300 mb-2 p-1"><canvas id="preview-1" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-slate-200 group-hover:text-white">CHEVALIER</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">LOURD & TANQUE</p>
                <div class="mt-2 text-[8px] bg-black text-slate-300 p-1 w-full text-left border border-slate-700">
                    <div>[J] Charge → Éjecte</div>
                    <div>[K] Onde Sismique</div>
                    <div>[L] Marteau Jugement</div>
                </div>
            </button>
            <button onclick="selectCharacter(2)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-purple-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-purple-400 mb-2 p-1"><canvas id="preview-2" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-purple-400 group-hover:text-white">VOLEUR</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">RAPIDE & CRITIQUE</p>
                <div class="mt-2 text-[8px] bg-black text-purple-300 p-1 w-full text-left border border-purple-800">
                    <div>[J] Charge CRIT ×1.6</div>
                    <div>[K] Pas de l'Ombre</div>
                    <div>[L] Pluie de Dagues</div>
                </div>
            </button>
            <button onclick="selectCharacter(3)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-amber-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-amber-400 mb-2 p-1"><canvas id="preview-3" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-amber-400 group-hover:text-white">ARCHER</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">TIR DISTANCE</p>
                <div class="mt-2 text-[8px] bg-black text-amber-300 p-1 w-full text-left border border-amber-800">
                    <div>[J] Charge → Éjecte</div>
                    <div>[K] Triple Volée</div>
                    <div>[L] Flèche 3000mi</div>
                </div>
            </button>
            <button onclick="selectCharacter(4)" onmouseenter="playAudioHover()" class="char-card pixel-box bg-slate-900 hover:bg-cyan-950 p-3 flex flex-col items-center transition transform hover:-translate-y-1 group">
                <div class="w-24 h-24 bg-black border-2 border-slate-700 group-hover:border-cyan-400 mb-2 p-1"><canvas id="preview-4" class="w-full h-full pixelated"></canvas></div>
                <h3 class="font-bold text-xs text-cyan-400 group-hover:text-white">MAGE</h3>
                <p class="text-[8px] text-slate-400 mt-1 text-center font-mono">SORTS & GEL</p>
                <div class="mt-2 text-[8px] bg-black text-cyan-300 p-1 w-full text-left border border-cyan-800">
                    <div>[J] Charge → Éjecte</div>
                    <div>[K] Orbe Glacial — GÈLE</div>
                    <div>[L] Météore 3000mi</div>
                </div>
            </button>
        </div>

        <div class="pixel-box bg-slate-900 p-3 max-w-2xl w-full text-center">
            <h4 class="text-xs text-yellow-400 mb-2 tracking-widest">REGLES & COMMANDES</h4>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-[9px]">
                <div class="bg-black p-2 border border-slate-700"><span id="ctrl-move" class="text-yellow-400">Q / D</span><br><span class="text-slate-400">DÉPLACEMENT</span></div>
                <div class="bg-black p-2 border border-slate-700"><span id="ctrl-jump" class="text-yellow-400">Z / ESPACE</span><br><span class="text-slate-400">SAUT & RETOUR</span></div>
                <div class="bg-black p-2 border border-slate-700"><span class="text-yellow-400">J (MAINTENIR)</span><br><span class="text-slate-400">CHARGE DIRECTIONNELLE</span></div>
                <div class="bg-black p-2 border border-slate-700"><span class="text-yellow-400">K & L (MAINTENIR)</span><br><span class="text-slate-400">SORTS CHARGÉS</span></div>
            </div>
            <p class="text-[8px] text-emerald-300 mt-2">⚡ CHARGE MAX = ÉJECTION 3000 MI (K.O.) • MI-CHARGE ≈ 1000 MI (REVENABLE !)</p>
            <p class="text-[8px] text-cyan-300 mt-1">🛡 TIENT LA DIRECTION OPPOSÉE À L'ATTAQUE AU MOMENT DU COUP = TU RÉSISTES À L'ÉJECTION !</p>
            <p class="text-[8px] text-red-400 mt-1">LIMITE : 3000 Miles = Out of Bounds. 3 Sorties pour Gagner !</p>
        </div>
    </div>

    <!-- HUD -->
    <div id="game-hud" class="absolute inset-x-0 bottom-4 flex justify-center items-end gap-6 pointer-events-none z-10" style="display:none">
        <div id="hud-p1" class="pixel-box-green bg-slate-950 p-3 w-60 text-center">
            <div class="text-[9px] text-emerald-400 tracking-wider mb-1">JOUEUR 1</div>
            <div id="p1-name" class="text-xs font-bold text-white truncate">PEPE TRACKSUIT</div>
            <div id="p1-percent" class="text-3xl font-black text-white my-1">0%</div>
            <div id="p1-status" class="text-[9px] h-3 mb-1 font-bold text-cyan-300"></div>
            <div id="p1-charge-label" class="text-[8px] text-yellow-300 h-2 mb-0.5 font-bold"></div>
            <div id="p1-charge-container" class="w-full bg-gray-900 h-2 border border-white mb-2 relative hidden">
                <div id="p1-charge-bar" class="bg-yellow-400 h-full w-0" style="transition: width 0.05s linear;"></div>
            </div>
            <div class="grid grid-cols-2 gap-1 text-[8px] mt-1 font-mono">
                <div class="bg-black p-1 border border-slate-700"><span id="p1-sk1" class="text-yellow-400">K</span><div id="p1-cd-k" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
                <div class="bg-black p-1 border border-slate-700"><span id="p1-sk2" class="text-yellow-400">L</span><div id="p1-cd-l" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
            </div>
            <div class="flex justify-center gap-2 mt-2 text-lg" id="p1-lives"></div>
        </div>

        <div class="text-2xl font-black text-yellow-400 italic pb-6 drop-shadow-[2px_2px_0px_#000]">VS</div>

        <div id="hud-p2" class="pixel-box-red bg-slate-950 p-3 w-60 text-center">
            <div class="text-[9px] text-red-400 tracking-wider mb-1">CPU (IA)</div>
            <div id="p2-name" class="text-xs font-bold text-white truncate">PEPE CHEVALIER</div>
            <div id="p2-percent" class="text-3xl font-black text-white my-1">0%</div>
            <div id="p2-status" class="text-[9px] h-3 mb-1 font-bold text-cyan-300"></div>
            <div id="p2-charge-label" class="text-[8px] text-red-300 h-2 mb-0.5 font-bold"></div>
            <div id="p2-charge-container" class="w-full bg-gray-900 h-2 border border-white mb-2 relative hidden">
                <div id="p2-charge-bar" class="bg-red-500 h-full w-0" style="transition: width 0.05s linear;"></div>
            </div>
            <div class="grid grid-cols-2 gap-1 text-[8px] mt-1 font-mono opacity-80">
                <div class="bg-black p-1 border border-slate-700"><span id="p2-sk1" class="text-red-400">K</span><div id="p2-cd-k" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
                <div class="bg-black p-1 border border-slate-700"><span id="p2-sk2" class="text-red-400">L</span><div id="p2-cd-l" class="cd-bar-bg h-1.5 w-full mt-0.5"><div class="cd-bar-fill h-full w-full"></div></div></div>
            </div>
            <div class="flex justify-center gap-2 mt-2 text-lg" id="p2-lives"></div>
        </div>
    </div>

    <!-- Combo -->
    <div id="combo-counter" class="absolute top-6 left-1/2 z-20 pointer-events-none text-3xl font-black text-orange-400 drop-shadow-[3px_3px_0px_#000]" style="display:none">×2 COMBO !</div>

    <!-- K.O. Flash -->
    <div id="ko-flash" class="absolute inset-0 z-30 items-center justify-center pointer-events-none" style="display:none">
        <span class="text-6xl md:text-8xl font-black text-red-500 drop-shadow-[6px_6px_0px_#000]">K.O. !</span>
    </div>

    <!-- Flèche ENNEMI hors écran (rouge) -->
    <div id="arrow-enemy-box" class="off-arrow bg-red-950/95 border-2 border-red-500">
        <span id="arrow-enemy-icon" class="text-xl inline-block text-red-300">➔</span>
        <div class="text-left leading-tight">
            <div id="arrow-enemy-tag" class="text-[8px] text-red-400 font-bold">ENNEMI</div>
            <div id="arrow-enemy-dist" class="text-[10px] font-bold text-red-300">0 / 3000 mi</div>
        </div>
    </div>

    <!-- Flèche TOI hors écran (verte) : pointe le chemin du retour -->
    <div id="arrow-self-box" class="off-arrow bg-emerald-950/95 border-2 border-emerald-400">
        <span id="arrow-self-icon" class="text-xl inline-block text-emerald-300">➔</span>
        <div class="text-left leading-tight">
            <div id="arrow-self-tag" class="text-[8px] text-emerald-400 font-bold">TOI</div>
            <div id="arrow-self-dist" class="text-[10px] font-bold text-emerald-300">0 / 3000 mi</div>
        </div>
    </div>

    <!-- Aide au retour -->
    <div id="recovery-hint" class="absolute bottom-44 left-1/2 -translate-x-1/2 z-20 pointer-events-none pixel-box-yellow bg-yellow-900/90 text-yellow-300 text-[10px] p-2 text-center" style="display:none">MAINTIENS ◀ + SAUT POUR REVENIR !</div>

    <!-- Fin de partie -->
    <div id="game-over" class="absolute inset-0 bg-black/90 flex-col items-center justify-center z-30" style="display:none">
        <h2 id="winner-title" class="text-4xl md:text-6xl font-black text-yellow-400 mb-2 tracking-widest drop-shadow-[4px_4px_0px_#000]">VICTOIRE !</h2>
        <p id="winner-sub" class="text-slate-300 mb-8 text-xs md:text-sm text-center px-4">Vous avez atomisé l'ennemi !</p>
        <button onclick="resetGame()" onmouseenter="playAudioHover()" class="pixel-box-yellow bg-yellow-500 hover:bg-yellow-400 text-black font-black px-8 py-4 text-sm transition cursor-pointer">REJOUER</button>
    </div>

    <div id="damage-container" class="absolute inset-0 pointer-events-none z-20 overflow-hidden"></div>

    <canvas id="game-canvas"></canvas>

    <script>
        // ==================== CONFIG CLAVIER ====================
        let currentLayout = 'AZERTY';
        function toggleLayout() {
            currentLayout = currentLayout === 'AZERTY' ? 'QWERTY' : 'AZERTY';
            document.getElementById('layout-toggle').innerText = `CLAVIER: ${currentLayout}`;
            const moveTxt = document.getElementById('ctrl-move');
            const jumpTxt = document.getElementById('ctrl-jump');
            if (currentLayout === 'AZERTY') { moveTxt.innerText = 'Q / D'; jumpTxt.innerText = 'Z / ESPACE'; }
            else { moveTxt.innerText = 'A / D'; jumpTxt.innerText = 'W / ESPACE'; }
            playAudioSelect();
        }
        const keyLeft = () => currentLayout === 'AZERTY' ? (keys['KeyQ'] || keys['ArrowLeft']) : (keys['KeyA'] || keys['ArrowLeft']);
        const keyRight = () => keys['KeyD'] || keys['ArrowRight'];
        const keyUp = () => (currentLayout === 'AZERTY' ? keys['KeyZ'] : keys['KeyW']) || keys['ArrowUp'];

        // ==================== AUDIO 8-BIT ====================
        let audioCtx = null, audioMuted = false;
        function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
        function toggleAudio() { audioMuted = !audioMuted; document.getElementById('audio-toggle').innerText = audioMuted ? "SON: OFF" : "SON: ON"; }
        function playSoundSweep(s, e, type, dur, vol = 0.2) {
            if (audioMuted) return; initAudio();
            try {
                const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(s, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(Math.max(1, e), audioCtx.currentTime + dur);
                gain.gain.setValueAtTime(vol, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + dur);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(); osc.stop(audioCtx.currentTime + dur);
            } catch (err) {}
        }
        function playNoise(dur, vol = 0.3) {
            if (audioMuted) return; initAudio();
            try {
                const n = audioCtx.sampleRate * dur, buf = audioCtx.createBuffer(1, n, audioCtx.sampleRate), d = buf.getChannelData(0);
                for (let i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;
                const src = audioCtx.createBufferSource(); src.buffer = buf;
                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(vol, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + dur);
                src.connect(gain); gain.connect(audioCtx.destination); src.start();
            } catch (err) {}
        }
        const playAudioHover = () => playSoundSweep(250, 500, 'square', 0.05, 0.05);
        const playAudioSelect = () => playSoundSweep(300, 800, 'triangle', 0.12, 0.15);
        const playAudioJump = () => playSoundSweep(140, 400, 'square', 0.12, 0.12);
        const playAudioDoubleJump = () => playSoundSweep(280, 650, 'square', 0.12, 0.12);
        const playAudioHit = (step = 1) => { playSoundSweep(150 + step * 80, 50, 'sawtooth', 0.1, 0.2); playNoise(0.08, 0.15); };
        const playAudioSpecial = (c = false) => { if (c) { playSoundSweep(100, 950, 'sawtooth', 0.45, 0.35); playNoise(0.35, 0.35); } else playSoundSweep(300, 700, 'square', 0.2, 0.2); };
        const playAudioKO = () => { playNoise(0.4, 0.4); playSoundSweep(180, 30, 'sawtooth', 0.4, 0.3); };
        const playAudioCrit = () => { playSoundSweep(500, 150, 'sawtooth', 0.18, 0.3); playSoundSweep(750, 250, 'square', 0.15, 0.2); };
        const playAudioFreeze = () => { playSoundSweep(1400, 400, 'sine', 0.35, 0.25); playSoundSweep(900, 300, 'triangle', 0.3, 0.2); };
        const playAudioTeleport = () => { playSoundSweep(200, 1200, 'sine', 0.12, 0.22); playSoundSweep(1200, 300, 'sine', 0.1, 0.15); };
        const playAudioTornado = () => { playNoise(0.7, 0.15); playSoundSweep(100, 320, 'triangle', 0.6, 0.15); };
        const playAudioMeteorFall = () => playSoundSweep(60, 260, 'sawtooth', 0.7, 0.28);
        const playAudioBigExplosion = () => { playNoise(0.5, 0.5); playSoundSweep(150, 35, 'sawtooth', 0.5, 0.4); };
        const playAudioDagger = () => playSoundSweep(1200, 700, 'square', 0.05, 0.08);
        const playAudioShock = () => { playSoundSweep(90, 40, 'square', 0.25, 0.3); playNoise(0.15, 0.2); };
        const playAudioReady = () => playSoundSweep(500, 900, 'square', 0.08, 0.12);
        const playAudioLaunch = () => { playSoundSweep(60, 900, 'sawtooth', 0.55, 0.4); playNoise(0.45, 0.3); };
        const playAudioResist = () => { playSoundSweep(900, 200, 'square', 0.15, 0.3); playSoundSweep(1400, 800, 'triangle', 0.12, 0.2); };
        const playAudioRecovery = () => { playSoundSweep(200, 900, 'triangle', 0.25, 0.25); playNoise(0.1, 0.1); };

        // ==================== CONFIG ====================
        const MILES_PER_UNIT = 20;
        const BLAST_MILES = 3000;
        const milesOf = x => Math.abs(x) * MILES_PER_UNIT;

        const CHAR_TYPES = [
            { name: "Pepe Tracksuit", speed: 0.22, weight: 1.0, cdK: 90, cdL: 260 },
            { name: "Pepe Chevalier", speed: 0.17, weight: 1.5, cdK: 110, cdL: 300 },
            { name: "Pepe Voleur", speed: 0.27, weight: 0.8, cdK: 130, cdL: 240 },
            { name: "Pepe Archer", speed: 0.20, weight: 0.9, cdK: 85, cdL: 270 },
            { name: "Pepe Mage", speed: 0.18, weight: 0.95, cdK: 110, cdL: 280 }
        ];
        const SKILL_NAMES = [
            { s1: 'CYCLONE', s2: 'TORNADO' }, { s1: 'SEISME', s2: 'MARTEAU' },
            { s1: 'OMBRE', s2: 'DAGUES' }, { s1: 'VOLEE', s2: 'BOOM' }, { s1: 'GLACIAL', s2: 'METEORE' }
        ];

        // ==================== TEXTURES PIXEL ART ====================
        function createPepeTexture(t) {
            const c = document.createElement('canvas'); c.width = 64; c.height = 64;
            const x = c.getContext('2d'); x.imageSmoothingEnabled = false;
            x.fillStyle = '#48b02c'; x.fillRect(16, 8, 32, 24); x.fillRect(12, 16, 40, 16);
            x.fillStyle = '#d32f2f'; x.fillRect(18, 28, 28, 5);
            x.fillStyle = '#b71c1c'; x.fillRect(20, 31, 24, 2);
            x.fillStyle = '#ffffff'; x.fillRect(14, 12, 14, 10); x.fillRect(36, 12, 14, 10);
            x.fillStyle = '#388e3c'; x.fillRect(14, 12, 14, 4); x.fillRect(36, 12, 14, 4);
            x.fillStyle = '#000000'; x.fillRect(20, 18, 6, 3); x.fillRect(40, 18, 6, 3);
            if (t === 0) { x.fillStyle = '#f8fafc'; x.fillRect(14, 34, 36, 20); x.fillStyle = '#84cc16'; x.fillRect(30, 34, 4, 20); x.fillRect(14, 42, 36, 3); x.fillStyle = '#cbd5e1'; x.fillRect(52, 10, 4, 40); x.fillStyle = '#78350f'; x.fillRect(50, 42, 8, 3); x.fillStyle = '#ef4444'; x.fillRect(8, 36, 10, 14); }
            else if (t === 1) { x.fillStyle = '#94a3b8'; x.fillRect(20, 2, 24, 12); x.fillRect(28, 0, 8, 4); x.fillStyle = '#64748b'; x.fillRect(14, 34, 36, 22); x.fillStyle = '#94a3b8'; x.fillRect(50, 14, 12, 18); x.fillStyle = '#78350f'; x.fillRect(52, 8, 3, 46); x.fillStyle = '#d1d5db'; x.fillRect(4, 34, 12, 22); }
            else if (t === 2) { x.fillStyle = '#1e1b4b'; x.fillRect(12, 4, 40, 16); x.fillRect(10, 12, 8, 24); x.fillStyle = '#312e81'; x.fillRect(14, 34, 36, 22); x.fillStyle = '#e2e8f0'; x.fillRect(50, 36, 10, 4); x.fillRect(54, 32, 3, 12); }
